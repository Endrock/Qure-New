        "result_KjXYfm": {
          "type": "result",
          "settings": {
            "image": "shopify:\/\/shop_images\/results_kim_l.webp",
            "heading": "Source of my unclear skin",
            "text": "<p>\"I didn’t realize how big impact water has on our skin... I almost got used to my skin never getting better than mediocre, but this Water Filter is a game changer in my skincare routine.”<\/p>",
