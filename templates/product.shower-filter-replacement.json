    "maximum_filtration_r4D6jm": {
      "type": "maximum_filtration",
      "name": "Maximum Filtration",
      "settings": {
        "heading": "Maximum filtration, minimal effort",
        "paragraph_1": "<p>The Qure Shower Filter is designed to remove up to 99% of chlorine – and other hard water nasties like copper, calcium, and lead – for healthy skin and hair.<\/p>",
        "paragraph_2": "<p>For optimized showering that leaves you feeling (and looking) your best, swap out the filter cartridge every 3 months.<\/p>",
        "paragraph_3": "<p>This Refill seamlessly fits the Qure Shower Filter system, providing long-lasting filtration benefits.<\/p>",
        "desktop_image": "shopify:\/\/shop_images\/maximum_filtration.webp",
        "mobile_image": "shopify:\/\/shop_images\/maximum_filtration_mob.webp",
        "icon_1_img": "shopify:\/\/shop_images\/ninety_day_supply_icon_4e272ea2-a224-4fe5-85a2-aa41aa234b98.svg",
        "icon_1_text": "90-day supply",
        "icon_2_img": "shopify:\/\/shop_images\/easy_rep_icon_96dcbf71-e250-4083-9671-39e5d375789d.svg",
        "icon_2_text": "Easy replacement",
        "icon_3_img": "shopify:\/\/shop_images\/dermatologist_tested_icon_7a09a69c-53ce-4a1d-98d3-f339667d32d0.svg",
        "icon_3_text": "Dermatologist tested"
      }
    },
