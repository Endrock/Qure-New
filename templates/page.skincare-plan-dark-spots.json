    "pdm_lifestyle_tips_bCbTKb": {
      "type": "pdm_lifestyle-tips",
      "blocks": {
        "tip_qdCXLz": {
          "type": "tip",
          "settings": {
            "title": " Reduce Sugar And Processed Food",
            "description": "<p>Studies show that excess sugar and processed food can lead to increased inflammation which may worsen pigmentation.</p>",
            "image_card": "shopify://shop_images/image_-_2025-01-20T164516.349.png",
            "sources": ""
          }
        },
        "tip_8x8iED": {
          "type": "tip",
          "settings": {
            "title": " Improve Your Sleep Routine",
            "description": "<p>Sleep is when your skin does most of its repair work. Elevating your head slightly and using a silk pillowcase can reduce puffiness and inflammation.</p>",
            "image_card": "shopify://shop_images/image_-_2025-01-20T164637.583.png",
            "sources": ""
          }
        },
        "tip_WqzmXT": {
          "type": "tip",
          "settings": {
            "title": "Protect Your Skin Daily",
            "description": "<p>Daily SPF is a must. It’s the easiest way to protect your skin from UV damage and prevent sun spots and dark spots from forming.</p>",
            "image_card": "shopify://shop_images/image.jpg",
            "sources": ""
          }
        },
        "tip_ChLfdj": {
          "type": "tip",
          "settings": {
            "title": "Nourish from the Inside",
            "description": "<p>Healthy skin starts with a balanced diet. Include foods rich in omega-3s, like salmon and walnuts, to support your skin’s elasticity and keep it looking firm and even.</p>",
            "image_card": "shopify://shop_images/image_f0011aed-1bf8-49f4-83a7-4dc18495fcca.jpg",
            "sources": ""
          }
        },
        "tip_mRnVgk": {
          "type": "tip",
          "settings": {
            "title": "Exfoliate Regularly",
            "description": "<p>Exfoliating 1-2 times a week with gentle exfoliants like AHAs (alpha hydroxy acids) or BHAs (beta hydroxy acids) helps remove dead skin cells and promotes cell turnover which lightens the appearance of dark spots.</p>",
            "image_card": "shopify://shop_images/image_1_30bd618b-5073-4caf-84d2-1a8d30bcf4da.jpg",
            "sources": ""
          }
        }
      },
      "block_order": [
        "tip_qdCXLz",
