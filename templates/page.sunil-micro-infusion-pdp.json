        "serum_pVVLFB": {
          "type": "Serum",
          "settings": {
            "background": "bg-yellow",
            "pd_img": "shopify://shop_images/serhum.png",
            "name": "",
            "serum_type": "Rejuvenating",
            "benefit1": "Brightens  discolouration",
            "icon1": "shopify://shop_images/brightens-even-skin-tone_1.png",
            "benefit2": "Fades  dark spots",
            "icon2": "shopify://shop_images/unique_reduce_line.svg",
            "benefit3": "Promotes even  skin tone",
            "icon3": "shopify://shop_images/boosts-hydration-02_1_071958b6-9b9b-428b-bd41-944b7590d5bd.svg",
            "title1": "What can it do for your skin",
            "drop_txt1": "<p>Reveals a <strong>smoother, brighter looking,</strong> and evenly <strong>radiant complexion</strong> to generate a glow effect. Renewal properties to help fade the appearance of dark spots and restore even-looking, smoother-feeling skin.</p><p><strong>Skin Concerns:</strong>Designed for skin with discolouration, rough texture, enlarged pores, acne marks and dark spots.</p>",
            "title2": "All Ingredients",
            "drop_txt2": "<p><strong>Epidermal Growth Factor (EGF):</strong><br/>Works at a cellular level to repair and rejuvenate skin. Reduces appearance of wrinkles, improves hydration, and prevents pigmentation.</p><p><strong>Niacinamide:</strong> Superstar ingredient that helps with most skin concerns from soothing to brightening and clarifying, and reducing look of fine lines and wrinkles.</p><p><strong>Tranexamic Acid:</strong> Helps to fade look of dark spots and discolouration. Assists with brightening and evening look of skin tone.</p><p><strong>All ingredients:</strong><br/>Rosa Damascena Flower Water, Propanediol, Glycerin, Tranexamic Acid, Niacinamide, Panthenol, Chrysanthellum Indicum Extract, Ethylhexylglycerin, Tripeptide-1, Xanthan Gum, Allantoin, Sh-Oligopeptide-1.</p><p>Please note that due to innovative updates and changing regulatory guidelines, the ingredient lists provided here may differ slightly from those on our packaging and distributor websites.</p>",
            "title3": "",
            "drop_txt3": "",
            "review": "",
            "client": "",
            "place": ""
          }
        },
        "or_Rw8iX6": {
          "type": "or",
          "settings": {
