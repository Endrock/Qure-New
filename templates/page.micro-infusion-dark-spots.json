    "two_column_box_EGirxP": {
      "type": "two-column-box",
      "blocks": {
        "image_Ee7chB": {
          "type": "image",
          "settings": {
            "image": "shopify:\/\/shop_images\/dual_action_new.webp",
            "image_mobile": "shopify:\/\/shop_images\/dual_action_new_mob.webp",
