        "object_WEHPg7": {
          "type": "object",
          "settings": {
            "heading": "Does it affect water pressure?",
            "text": "<p>The Qure Shower Filter is designed to maintain water pressure while effectively filtering impurities. You’ll enjoy clean water without compromising your shower experience.<br/><br/></p>",
