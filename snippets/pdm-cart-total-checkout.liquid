{% comment %}
  Usage: {% render 'pdm-cart-total-checkout' price_check: price_check, shipping_charge: shipping_charge, subtotal_price:subtotal_price, savings: savings, is_only_gift:is_only_gift %}
{% endcomment %}

<p class="drawer__cart-total-price pdm-Total-Checkout">
  {% if savings %}
    <span class="old_price-cart" data-compare-price="{{ subtotal_price | plus: savings | money_without_currency }}">{{ subtotal_price | plus: savings | money_without_trailing_zeros }}</span>
  {% endif %}
  <span class="cart_items_subtotal_price money" id="cart_items_subtotal_price" data-value="{{ subtotal_price }}">{{ subtotal_price | money_without_trailing_zeros }}</span>
</p>