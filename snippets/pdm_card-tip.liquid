<div class="card {{ class }} {% if active-card == index %}active{% endif %}" index="{{ index }}" length="{{ length }}" > 
    <div class="cont-image">
        <img src="{{ image | img_url: "original" }}" alt="picture for {{ title }}" />
    </div>
    <div class="cont-text">
        <div class="pagination">
        {% if length > 1 %}
            {% for i in (1..length)%}
                <div data-card={{ i }} class="num {% if i == index %}active{% endif %}">{{ i }}</div>
            {% endfor %}
        {% endif %}
        </div>
        <div class="full-text">
            <div class="title">
                <h3 class="h3">{{ title }}</h3>
            </div>
            <div class="description">{{ description }}</div>
        </div>
        <div class="arrows">
        {% if length > 1 %}
                <div class="previous {% if index > 1 %}active{% endif %}">{% render "pdm_svg-arrow" %}</div> 
                <div class="next {% if index < length %}active{% endif %}">{% render "pdm_svg-arrow" %}</div> 
        {% endif %}
        </div>
    </div>
</div>
