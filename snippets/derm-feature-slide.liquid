{% comment %}
{% render 'derm-feature-slide' 
video: block.settings.video,
review: block.settings.review,
doctor: block.settings.review_doctor,
certified: block.settings.certified_doctor,
product: block.settings.product %}
{% endcomment %}

<div class="swiper-slide">
  <div class="slide-cont">
    <div class="video-cont" data-index="{{ index }}">
      <img class="img-overlay" src="{{ img_ovl | img_url: 'original' }}" alt="video overlay image"></img>
      <img class="img-icon-play" src="{{ img_play | img_url: 'original' }}" alt="video overlay image"></img>
    </div>
    <div class="text-cont">
      <div class="review">
        {{ review }}
      </div>
      <div class="doctor-info">
        <div class="doctor">{{ doctor }}</div>
        <div class="certified">{{ certified }}</div>
      </div>
      <div class="product-cont">
        <a class="link-product" href="{{ product.url }}">
            <div class="img-product">
              <img loading="lazy" class="thumbs-product" src="{{ product.featured_image | img_url: 'small' }}" alt="{{ product.title }}">
            </div>
            <div class="name-product">{{ product.title }}</div>
        </a>
      </div>
    </div>
   </div>
</div>
