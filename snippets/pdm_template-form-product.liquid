{%- comment -%}
  Renders the PDM landing serums free patches form template with free patches variant for AB test.

  Purpose:
  Dynamically builds and displays multiple subscription plan options (e.g., 6-month, 3-month, 2-month, 1-month) and make the free patches appears for the AB test.
  It loops through a provided array of block IDs, fetches each block’s product data, calculates pricing and discount details,
  and outputs the corresponding HTML structure with data attributes for JS-driven tab and plan selection logic.

  Accepts:
  - array: (array) Required. List of block IDs to render in order.
  - section: (object) Required. Section settings including form_name, form_type, heading blocks, images, and preorder/sold-out flags.
  - product_type_title: (string) Required. Used to build unique IDs and scoping CSS/JS hooks.

  Usage:
  {% render 'pdm_template-form-product', array: array, section: section, product_type_title: product_type_title %}

  Dependencies:
  - Stylesheet: _pdm_landing-serums-free-patches.css
  - Script: __pdm_template-form-product.js
  - Snippet: 'pdm_stock-items-left' for rendering stock-left counters when `left_items` is true
  - External assets for icons/images referenced via full URLs

  Notes:
  - Ensure each block in `array` has type 'product' and valid `settings.product`.
  - Blocks marked `preselected` will have their radio input initially checked.
  - Pre-order and sold-out states override the default “Buy now” text.
  - Pricing per item, discount percentage, and included-text accordions are generated via Liquid captures.
{%- endcomment -%}

{% capture product-included-dropdown %}{% endcapture %}

<template
  class="template-abtest"
  id="{{ section.settings.form_name }}-source-{{ section.id }}-{{ product_type_title }}"
>
  <div class="step_content" id="{{ section.id }}-{{ product_type_title }}">
    <div class="step_conten_blocks">
      {%- for __id in array -%}
        {% assign block = section.blocks | where: 'id', __id | first %}
        {% if block.type == 'product' %}
          {% assign product = all_products[block.settings.product] %}

          {% if product != blank and product.available %}
            {% assign product_id = product.id %}
            {% assign product_variant_id = product.variants.first.id %}
            {% assign product_price_divided = product.price | divided_by: 4 %}
            {% assign discount_percentage = product.price | times: 1.0 | divided_by: product.compare_at_price | minus: 1 | abs | times: 100 | ceil %}
            {% assign product_title_tag = block.settings.heading | strip_newlines | strip | replace: ' ', '' | replace: ',', '_' | downcase %}
            {% assign product_price = product.price | money_without_trailing_zeros %}
            {% assign product_price_compare = product.compare_at_price | money_without_trailing_zeros %}

            {% assign array_count = array_count |  minus: 1 %}
            {% assign product_type = array_count %}
            
            {% if product_price_compare == blank %}
                {% assign discount_percentage = blank %}
            {% endif %}

            {% assign product_price_per_item = blank %}

            {% if block.settings.total_treatments > 0 %}
                {% assign product_price_per_item = product.price | divided_by: block.settings.total_treatments %}
            {% endif %}

            {% capture product-included-dropdown %}
                {{ product-included-dropdown }}
                <div class="tab_content" id="tab_{{ product_title_tag }}">
                    <div class="plan_bundle_detail">
                        <h6 class="cs_item__accordion">Buy one "{{ block.settings.heading }}" and get:<span><img src="https://qureskincaredns.com/new/assets/arrow-up.png" alt=""></span></h6>
                        <div class="u_item__hidden-div" style="display: none;">
                            {{ block.settings.included_text |  replace: '<p>', '<p><span><img src="https://qureskincaredns.com/new/assets/tick.png" alt=""></span>' }}
                        </div>
                    </div>
                </div>
            {% endcapture %}

            {% capture data-per %}Buy now {% if discount_percentage != blank %} & SAVE {{ discount_percentage }}%{% endif %}{% endcapture %}

            {% if block.settings.preorder == true %}
                {% capture data-per %}Reserve now {% if discount_percentage != blank %} & SAVE {{ discount_percentage }}%{% endif %}{% endcapture %}
            {% endif %}

            {% if block.settings.soldout == true %}
                {% capture data-per %}Sold Out{% endcapture %}
            {% endif %}

            <div
              class="planBlock ignore"
              href="javascript:void(0)"
              data-tab="tab_{{ product_title_tag }}"
              data-pay="{{ product_price_divided | money_without_trailing_zeros }}"
              data-per="{{ data-per }}"
              {% if block.settings.free_patches %}
                data-image="{{ block.settings.free_patches_product.featured_media | image_url: width: 800 }}"
                data-product_variant_id="{{ block.settings.free_patches_product.selected_or_first_available_variant.id }}"
              {% else %}
                data-image="{{ block.settings.image | image_url: width: 800 }}"
                data-product_variant_id="{{ product_variant_id }}"
              {% endif %}
              data-soldout="{{ block.settings.soldout }}"
              data-preorder="{{ block.settings.preorder }}"
              data-type="{{ product_type }}"
            >

              {% if block.settings.preselected == true %}
                  <div class="best_value">Best Value<span><img src="https://qureskincaredns.com/new/assets/star_new.svg" alt="" class="img-fluid ms-1"></span></div>
              {% endif %}

              <input
                type="radio"
                name="monthlyPlan_{{ section.settings.form_name }}"
                id="{{ section.id }}-{{ product_title_tag }}"
                {% if block.settings.preselected == true %}
                  checked
                {% endif %}
              >
              <label class="monthly_plans" for="{{ section.id }}-{{ product_title_tag }}">
                <div class="monthly_supply">
                  {% if block.settings.free_patches %}
                  <div class="monthly_supply--inner">
                  {% endif %}
                    <div class="plan_des">
                      <div class="plan_hdr">
                        <h3>{{ block.settings.heading }}</h3>

                          {% if block.settings.preorder == true %}
                              <span class="saved_price pre_order">PRE ORDER</span>
                          {% else %}
                              {% if discount_percentage != blank %}
                                  <span class="saved_price">SAVE {{ discount_percentage }}%</span>
                              {% endif %}
                          {% endif %}
                      </div>
                      <div class="plan_des">{{ block.settings.subheading }}</div>
                    </div>
                    <div class="price_wrapper">
                      <div class="price">
                          {% if product_price_compare != blank %}
                              <div class="plan_prc regular_price">{{ product_price_compare }}</div>
                              <div class="plan_prc sale_price color_red">{{ product_price }}</div>                                                    
                          {% else %}
                              <div class="plan_prc sale_price">{{ product_price }}</div>
                          {% endif %}
                      </div>
                      {% if block.settings.left_items %}
                        {% render 'pdm_stock-items-left', product_id: product_id %}
                      {% endif %}
                    </div>
                  {% if block.settings.free_patches %}
                  </div>
                  {% endif %}

                  {% if block.settings.free_patches %}
                    {{ '_pdm_landing-serums-free-patches.css' | asset_url | stylesheet_tag }}
                    <!-- “Free Patch” badge desktop -->
                    <div class="pdm_free-patch desktop">
                      <img
                      {% if block.settings.free_patches_icon != blank %}
                        src="{{ block.settings.free_patches_icon | image_url: width: 80 }}"
                      {% else %}
                        src="https://cdn.shopify.com/s/files/1/0441/1431/3365/files/patches_168px.png?v=1745556105"
                      {% endif %}
                        width="42"
                        height="26"
                        alt="Micro-Infusion Patch icon"
                      >
                      <span>{{ block.settings.free_patches_text }}</span>
                    </div>
                    <!-- End of “Free Patch” badge desktop -->
                  {% endif %}
                </div>
                {% if product_price_per_item != blank %}
                    {% if block.settings.preselected == true %}
                        <div class="supply_fire"><p>🔥 Only {{ product_price_per_item | money_without_trailing_zeros }} per treatment </p></div>
                    {% else %}
                        <div class="supply_fire bg_linear_pink"><p>Only {{ product_price_per_item | money_without_trailing_zeros }} per treatment </p></div>
                    {% endif %}
                {% endif %}
              </label>
            </div>

            {% if block.settings.preorder == true %}
              {% capture preorder-box-items %}{{ preorder-box-items }}<div class="{{ section.settings.form_name }}-preorder-box-item {{ section.settings.form_name }}-preorder-box__{{ product_variant_id }}"></div>{% endcapture %}

              {% if block.settings.preorder_text != blank %}
                <span class="{{ section.settings.form_name }}-product-preorder-text__{{ product_variant_id }} hide">
                  {{- block.settings.preorder_text -}}
                </span>
              {% endif %}
              {% if block.settings.preorder_date_soldout != blank %}
                <span class="{{ section.settings.form_name }}-product-preorder_date_soldout__{{ product_variant_id }} hide">
                  {{- block.settings.preorder_date_soldout -}}
                </span>
              {% endif %}
              {% if block.settings.preorder_date_reserved != blank %}
                <span class="{{ section.settings.form_name }}-product-preorder_date_reserved__{{ product_variant_id }} hide">
                  {{- block.settings.preorder_date_reserved -}}
                </span>
              {% endif %}
              {% if block.settings.preorder_percent != blank %}
                <span class="{{ section.settings.form_name }}-product-preorder_percent__{{ product_variant_id }} hide">
                  {{- block.settings.preorder_percent -}}
                </span>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endif %}
      {%- endfor -%}

      {{ preorder-box-items }}

      {{ preorder_box }}
    </div>

    {{ product-included-dropdown }}
  </div>
</template>
<script defer src="{{ '__pdm_template-form-product.js' | asset_url }}"></script>
