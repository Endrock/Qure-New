<div class="card-bundle" data-product-id="{{ product.id }}">
  <div class="cont-card-bundle">
    <div class="pdm-gallery">
      <div class="media">
          <img src="{{ product.featured_image | img_url: 'medium' }}" alt="image {{ product.title }}">
      </div>
      <div class="media-btns">
        <div class="product active">Product</div>
        <div class="results">Real Results</div>
        <div class="how-work">How It works</div>
      </div>
    </div>
    <div class="product-info">
      <div class="title"><h3>{{ product.title }}</h3></div>
      <div class="text-checks">
          {{ text-checks }}
      </div>
    </div>
    <div class="doctor-info">
        <div class="photo">
            <img class="photo-doctor" src="{{ doctor-image | img_url: 'medium' }}" alt="{{ doctor-name }}">
        </div>
        <div class="doctor-text">
            <div class="review">
                {{ doctor-text }}
            </div>
            <div class="doctor-data">
                <strong>{{ doctor-name }}</strong> | {{ doctor-certificated }}
            </div>
        </div>
    </div>
    <div class="bundle-button">
        <div class="price">
          {{ product.price | money }}
        </div>
        <div class="bundle-btn">
            {{ btn-text }}
        </div>
    </div>
  </div>
</div>
