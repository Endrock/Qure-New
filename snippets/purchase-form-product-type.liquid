{% if array != blank %}

    {% comment %} {% assign products = blank %} {% endcomment %}

    {%- for __id in array -%}
        {% assign block = section.blocks | where: "id", __id | first %}
        {% if block.type == 'product_type' %}
            {% assign product_type_title = block.settings.heading | strip_newlines | strip | replace: ' ', '' | downcase %}
            <div class="serumBlock" id="{{ product_type_title }}">
                <input type="radio"{% if active %} class="active"{% endif %} name="serum" id="{{ block.id }}" />
                <label class="serum_prd" for="{{ block.id }}">
                    <div class="serum_img active">
                        <img src="{{ block.settings.image | img_url: 'master' }}" alt="" class="img-fluid" />
                    </div>
                    <h4 class="serum_ttl"><span>For <strong> {{ block.settings.heading }}</strong></span> </h4>
                </label>
            </div>            
        {% endif %}
        {% comment %} {% if block.type == 'product' %}
            {% assign products = products |  prepend: block.settings.product |  prepend: ','   %}
        {% endif %} {% endcomment %}
    {%- endfor -%}    

    {% comment %} <script>
        document.addEventListener('DOMContentLoaded', function() {
            $('#{{ product_type_title }}').on('click', function() {
                loadContent('purchase-form-ajax' + ','+ $(this).attr('id') + '{{ products }}, cache');
            });
        });

        window.sectionBlocks = window.sectionBlocks || {};
        window.sectionBlocks['{{ product_type_title }}'] = [
            {%- for __id in array -%}
                {% assign block = section.blocks | where: "id", __id | first %}
                {% if block.type == 'product' %}
                {% assign block = section.blocks | where: "id", __id | first %}
                {
                    type: {{ block.type | json }},
                    settings: {{ block.settings | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endif %}
            {%- endfor -%}
        ];
    </script> {% endcomment %}

{% endif %}