{% comment %}
  This snippet displays a free gift section on a product page.
  It checks if the 'show_free_gift' setting is enabled and displays the gift image, heading, label, and price.

  parameters:
  - section: The section object containing settings for the free gift.

  usage:
  {% include 'pdm_free-gift-product' section: section%}

{% endcomment %}

{{ '__pdm-free-gift-product.css' | asset_url | stylesheet_tag }}

{% assign free_gift_image = section.settings.free_gift_image %}
{% assign free_gift_heading = section.settings.free_gift_heading %}
{% assign free_gift_label = section.settings.free_gift_label %}
{% assign free_gift_price = section.settings.free_gift_price %}
{% assign show_free_gift = section.settings.show_free_gift | default: true %}

{% if show_free_gift %}
  <div class="product-free-gift">
      <div class="product-free-gift__image">
        <img src="{{ free_gift_image | image_url: width:90 }}" alt="Free Gift" />
      </div>
      <div class="product-free-gift__description">
        <h3> Gift with Purchase:  <br> {{ free_gift_heading }}</h3>
        <div class="product-free-gift__description-price">
          <span class="free-gift-label">{{ free_gift_label }}</span>
          <p class="free-gift-price"><span>{{ free_gift_price }}</span> FREE</p>
        </div>
      </div>
  </div>
{% endif %}