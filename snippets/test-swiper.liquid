<style>

    .swiper-slide .image-container {
      background-color: red;
      height: 300px !important;
      width: 100% !important;
    }
</style>
<div class="container">
  <div class="swiper sample-slider">
      <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="image-container" style="background-color: red;"></div>
            </div>
          <div class="swiper-slide">
            <div class="image-container" style="background-color: blue;"></div>
            </div>
          <div class="swiper-slide">
            <div class="image-container" style="background-color: green;"></div>
            </div>
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
  </div>

</div>

<script>
    const swiper = new Swiper('.sample-slider', {
        loop: true,
        slidesPerView: 2,
        centeredSlides: true,
        mousewheel: {
          forceToAxis: true,
        },
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },
    })
</script>