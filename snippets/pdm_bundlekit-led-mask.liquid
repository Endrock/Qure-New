{{ '__pdm_bundlekit_led_mask.css' | asset_url | stylesheet_tag }}
<script defer src="{{ '__pdm_bundlekit_led_mask.js' | asset_url }}"></script>


{% liquid
  assign title_original_product = section.settings.title_original_product
  assign product_kit_1 = section.settings.product_kit_1
  assign product_kit_image_1 = section.settings.product_kit_image_1
  assign title_product_kit_2 = section.settings.product_kit_title

  assign product_kit_2 = section.settings.product_kit_2
  assign product_kit_image_2 = section.settings.product_kit_image_2
  assign product_kit_image_3 = section.settings.product_kit_image_3
  assign product_kit_bundle_price = section.settings.product_kit_price | replace: '{', '<s style="color:#0000004d; font-weight: 500;">' | replace: '}', '</s>'
  assign product_kit_product_price = section.settings.product_kit_product_price | replace: '{', '<s style="color:#0000004d; font-weight: 500;">' | replace: '}', '</s>'
  assign label_product_kit = section.settings.product_kit_label
  assign badged_product_kit = section.settings.product_kit_badged


%}

<div class="choose-your-kit-section">
  <h5>Choose Your Kit</h5>
  <div class="choose-your-kit-section__products">
      <label class="product-item product-original" for="productonly">
          <input 
          type="radio" 
          name="product-kit" 
          id="productonly" 
          value="{{ product_kit_1.variants.first.id }}" 
          data-product-original-title="{{ product_kit_1.description | strip_html }}"
          data-product-original-id="{{ product_kit_1.id }}"
          data-product-original-variant-id="{{ product_kit_1.variants.first.id }}" 
          data-product-original-handle="{{ product_kit_1.handle }}"
          data-product-original-image="{{ product_kit_image_1 | image_url: width: 400 }}"    
          data-productskincare-variant-id="{{ product_bundle1.variants.first.id }}">
          <div class="product-item-inner">
            <span class="product-item__label">
               {{ title_original_product }}
               <span> {{ product.variants.first.price | money_without_trailing_zeros }} </span>
            </span>
            <div class="inner-image">
                <img class="product-item__image" src="{{ product_kit_image_1 | image_url: width: 300}}" alt="{{ product.title | escape }}">
            </div>
          </div>
      </label>
      <label class="product-item product-bundle selected" for="productbundle">
          <div class="bundle-kit-label">{{ label_product_kit }}</div>
          <input 
            type="radio" 
            name="product-kit" 
            id="productbundle" 
            value="{{ product_kit_2.variants.first.id }}" 
            data-product-bundle-title="{{ product_kit_2.description | strip_html }}"
            data-product-bundle-id="{{ product_kit_2.id }}"
            data-product-bundle-variant-id="{{ product_kit_2.variants.first.id }}"
            data-product-bundle-handle="{{ product_kit_2.handle }}"
            data-product-bundle-image="{{ product_kit_image_2 | image_url: width: 400 }}"
            data-productskincare-variant-id="{{ product_bundle2.variants.first.id }}"
            checked>
          <div class="product-item-inner">
            <div class="inner-content">
              <span class="product-item__label"> {{ title_product_kit_2 }} </span>
              <div class="badge-label"> {{ badged_product_kit }} </div>
              <span class="product-item__bundle-price">{{ product_kit_bundle_price }}</span>
            </div>
            <div class="inner-image">
              <div>
                <img class="product-item__image" src="{{ product_kit_image_2 | image_url: width: 300}}" alt="{{ product_kit.title | escape }}">
                <span class="product-item__price">{{ product.variants.first.price | money_without_trailing_zeros }}</span>
              </div>
                +
              <div>
                <img class="product-item__image" src="{{ product_kit_image_3 | image_url: width: 300}}" alt="{{ product_kit.title | escape }}">
                <span class="product-item__price red-price"> {{ product_kit_product_price }}</span>
              </div>
            </div>
             
          </div>
      </label>
  </div>
</div> 