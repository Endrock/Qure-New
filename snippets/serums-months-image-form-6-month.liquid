                  {% if section.settings.popup_micro_infusion_enabled
                    and page.handle == 'qure-microinfusion-offer'
                    or page.handle == 'qure-micro-infusion-landing-page-affiliate'
                  %}
                    <button
                      data-popup-enabled="{{ section.settings.popup_micro_infusion_enabled }}"
                      data-popup-referrer="pdm_serums_m_image"
                      data-ajax-selector=".image-ajax-v2-container .btn.btn-atc"
                      class="upsell_popup_btn openPopupUpsell"
                    ></button>
                  {% endif %}
                  <a
                    class="btn btn-atc buy_btn submit_btn {{ section_id }}_productButtonObject"
                    href="{{ routes.cart_add_url }}?id={{ product.variants.first.id }}&quantity=1"
                    data-ajax-cart-request-button
                  >
                    Buy Now <span class="savedAmount">& SAVE {{ discount_percentage }}%</span>
                  </a>

                </div>
              </div>
            </div>
            <div class="c_s_shipping d-block d-md-none">
              <div class="c_s_wrapper cs_wrapper-pdm">
                <div class="c_s_bx">
                  {% render 'serums-months-svg-low-contrast', icon: 'thumbs_up' %}
                </div>
                <div class="c_s_bx">
                  {% render 'serums-months-svg-low-contrast', icon: 'truck' %}
                </div>
                <div class="c_s_bx">
                  {% render 'serums-months-svg-low-contrast', icon: 'shield' %}
                </div>
              </div>
