{% liquid
  assign price_first_element = ''
  assign price_second_element = ''
  assign price_third_element = ''

  assign product_6_month = section.settings.product_1
  assign product_3_month = section.settings.product_2
  assign product_1_month = section.settings.product_3
%}

<script>
  window.pdmSerumsMonthsImageForm = {
    product_6_month: {{ product_6_month.variants.first.id }},
    product_3_month: {{ product_3_month.variants.first.id }},
    product_1_month: {{ product_1_month.variants.first.id }},
  };
</script>

{% if section_id == blank %}
  <p>Please provide section_id property to use this snippet</p>
{% else %}

{{ '_pdm-ba-treatment-options.css' | asset_url | stylesheet_tag }}

  <style>
    .offer_active .supply_steps .step_block .step_content .serumBlock input.active + .serum_prd:after {
      display: none !important;
    }

    .planBlock .plan_choosed span {
      background: #000 !important;
    }

    .planBlock .plan_choosed {
      text-align: left !important;
      position: relative !important;
      left: 30px !important;
      max-width: 100% !important;
    }
    .step_counter_before:before {
      display: none !important;
    }
  </style>

  <!-- treatment section start -->
  <div class="available_bar">
    <p>SOLD OUT 10X - AVAILABLE UNTIL STOCK LASTS</p>
  </div>
  <div class="section productSubscription choose_serum form-{{ section_id }}" id="productSubscription">
    <div class="container">
      {% render 'pdm-ba-treatment-options',
        product_6_month: product_6_month,
        product_3_month: product_3_month,
        product_1_month: product_1_month,
      %}

      {% render 'pdm-test-6-month-price' %}
    </div>
  </div>
  <div
    id="pdm_price-difference-container"
    data-price-first="{{ price_first_element | minus: price_second_element | money_without_trailing_zeros }}"
    data-price-second="{{ price_second_element | minus: price_third_element | money_without_trailing_zeros }}"
    hidden
  ></div>

  <script src="{{ '__app_serums-months-form-v2.js' | asset_url }}"></script>
  <script defer src="{{ '__pdm-ba-treatment-options.js' | asset_url }}"></script>

{% endif %}


