                  <h3 class="align-items-baseline">Choose a payment option:</h3>
                </div>
                <div class="step_content item-3 pdm-step_content_v2">
                  <div class="pmtBlock">
                    <input type="radio" name="pmtPlan" id="pay_in_full" checked>
                    <label class="pmt_plans" for="pay_in_full">
                      <div class="pmt_des">
                        <div class="pmt_hdr">
                          <h3>Pay in full</h3>
                        </div>
                        <div class="pmt_row-test">
                          <div class="pmt_des">One-time payment with</div>
                          <div class="pmt_options">
                            {% if section.settings.payment_icons != blank %}
