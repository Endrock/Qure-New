            {% assign product = all_products['microinfusion-offer-6-month-supply'] %}
            {% assign divided_price = product.price | divided_by: 4 %}
            {% assign discount_percentage = product.price
              | times: 1.0
              | divided_by: product.compare_at_price
              | minus: 1
              | abs
              | times: 100
              | ceil
            %}
            <div class="supply_steps pdm-step_content_v2">
              <div class="step_counter step_counter_before"><span>2</span></div>
              <div class="step_block">
