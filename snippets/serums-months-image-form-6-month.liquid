                    <label class="pmt_plans" for="pay_today">
                      <div class="pmt_des">
                        <div class="pmt_hdr">
                          <h3>Pay today only</h3>
                        </div>
                        <div class="pmt_row-test">
                          <div class="pmt_des">Monthly interest-free payments with</div>
                          <div class="pmt_options item-2">
                            {% if section.settings.payment_icons_today_only != blank %}
                              {{
                                section.settings.payment_icons_today_only
                                | image_url: width: 150
                                | image_tag: alt: 'Payment Icons Today Only', class: 'pmt_options__image'
                              }}
                            {% endif %}
                          </div>
                        </div>
                      </div>
                      <div class="price">
                        <div class="pmt_prc pay_today">{{ divided_price | money_without_trailing_zeros }}</div>
                      </div>
                    </label>
                  </div>
                </div>

                {% if section.settings.popup_micro_infusion_enabled
                  and page.handle == 'qure-microinfusion-offer'
