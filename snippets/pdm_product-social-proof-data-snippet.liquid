{% liquid
  assign product_list_micro_infusion_refill = settings.product_list_microinfusion_refill | map: 'id'
  assign is_microinfusion_page_refill = false
  assign product_list_microinfusion_refill_allowlist = settings.product_list_microinfusion_refill_allowlist | split: ',' | strip
  if product_list_microinfusion_refill_allowlist contains page.handle
    assign is_microinfusion_page_refill = true
  endif

  assign product_list_micro_infusion = settings.product_list_microinfusion | map: 'id'
  assign is_microinfusion_page = false
  assign product_list_microinfusion_allowlist = settings.product_list_microinfusion_allowlist | split: ',' | strip
  if product_list_microinfusion_allowlist contains page.handle
    assign is_microinfusion_page = true
  endif

  assign product_list_infusion_target_patches = settings.product_list_targeted_patches | map: 'id'
  assign is_target_patches_page = false
  assign product_list_target_patches_allowlist = settings.product_list_targeted_patches_allowlist | split: ',' | strip
  if product_list_target_patches_allowlist contains product.handle
    assign is_target_patches_page = true
  endif

  assign product_list_allowlist = settings.product_list_allowlist
  assign product_list_allowlist_array = product_list_allowlist | split: ','
  assign product_id_string = product.id | append: ''

  if product_list_allowlist_array contains product_id_string
    assign product_in_list_allowlist = true
  else
    assign product_in_list_allowlist = false
  endif

  if template == 'product'
    assign suffix = product.template_suffix
  elsif template == 'page'
    assign suffix = page.template_suffix
  endif
%}

{% if settings.show_social_proof %}
  {% if product_in_list_allowlist or is_microinfusion_page_refill or is_microinfusion_page or is_target_patches_page %}
    <div
      class="social-proof-data-container hidden"
      data-suffix="{{ suffix }}"
      data-product-id="{{ product.id }}"
      data-page-handle="{% if is_microinfusion_page_refill or is_microinfusion_page %}{{page.handle}}{% elsif is_target_patches_page %}{{-product.handle-}} {% endif %}"
      data-product-list="{% if is_microinfusion_page_refill %}{{ product_list_micro_infusion_refill | join: ', ' }}{% elsif is_microinfusion_page %}{{ product_list_micro_infusion | join: ', ' }}{% elsif is_target_patches_page %}{{ product_list_infusion_target_patches |  join: ', ' }}{% endif %}"
    >
      <div class="circle-container">
        {%- render 'pdm_icon-social-proof', icon: 'circle' -%}
        {%- render 'pdm_icon-social-proof', icon: 'shine' -%}
      </div>
      <div class="text-container">
        <span id="quantity" class="quantity"></span>
        <span class="label">{{ settings.social_proof_label }}</span>
      </div>
      {% render 'pdm_icon-social-proof', icon: 'cross' %}
    </div>
  {% endif %}
{% endif %}
