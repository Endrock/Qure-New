{{  '_pdm_product-sticky-button.css' | asset_url |  stylesheet_tag }}
<div id="green-product-sticky-form-btn" class="button_sticky_wrapper {{ button_classname }}" data-product-id="{{ product.id }}">
  {{
    product.featured_image
    | image_url: width: 700
    | image_tag: alt: product.title, class: 'button_sticky_wrapper__product-image'
  }}
  <div class="button_sticky_wrapper__product-info">
    <div class="button_sticky_wrapper__product-info__text">
      <h4 class="button_sticky_wrapper__title">{{ product.title | escape }}</h4>
      {% render 'pdm_product-social-proof-data-snippet' %}
    </div>

    <a
      href="javascript:void(0)"
      onclick="formSubmit('{{ form_classname }}')"
      class="button_sticky {{ button_classname }} button_sticky_wrapper__button_sticky"
    >
      ADD TO BAG
    </a>
  </div>
</div>
