{% assign product_led_neck = all_products['neck-decolletage-led'] %}
{% assign product_led_mask = all_products['q-rejuvalight-pro-facewear-3'] %}

<!-- product bundle start -->
<div class="product_bundle offer-lp section" id="shop">
    <div class="container">
        <div class="product_bundle-content">
            <div class="row">
                <div class="col-md-6">
                    <div class="pe-md-3">
                        {% render 'purchase-form-carousel' %}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="bundle_select-main include ps-md-3">
                                <div class="product_details">
                                    <p class="limited_time_offer mb-2">Limited time offer</p>
                                    <h2 class="title-lg">Q-Rejuvalight Pro LED Mask<br>
                                        <span>+ FREE Neck & Décolletage LED Device</span>
                                    </h2>
                                    <p>Repair and rejuvenate your skin—and boost your self-esteem—with our
                                        FDA-cleared LED mask that treats acne, fine lines, wrinkles and dark
                                        spots.
                                    </p>
                                </div>
                                <div class="product-section pt-md-4">
                                    <p class="selection_title pb-3">What’s Included
                                    </p>
                                    <div class="include_wrap-main">
                                        <div class="include_wrap">
                                            <div class="include_pd-img">
                                                <img src="https://qureskincaredns.com/new/assets/include_pd-img1.webp"
                                                    class="img-fluid pt-md-0 pt-2" alt="">
                                            </div>
                                            <div class="include_pd-detail">
                                                <span>Bestseller</span>
                                                <h6>Q-Rejuvalight Pro LED Mask</h6>
                                                <p>FDA-cleared device that treats acne, fine lines, wrinkles and
                                                    dark spots.</p>
                                            </div>
                                            {% assign product = all_products['q-rejuvalight-pro-facewear-3'] %}
                                            <div class="include_pd-price">
                                                <h6>{{ product.price | money_without_trailing_zeros }}</h6>
                                            </div>
                                        </div>
                                        <div class="include_wrap">
                                            <div class="include_pd-img">
                                                <img src="https://qureskincaredns.com/new/assets/include_pd-img2_new.webp" class="img-fluid" alt="">
                                            </div>
                                            <div class="include_pd-detail">
                                                <h6>Neck & Décolletage LED Device
                                                    <span>
                                                        <button class="btn product_popup p-0 align-baseline"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#productInfoModal">
                                                            <img src="https://qureskincaredns.com/new/assets/i-mark.svg" alt="">
                                                        </button>
                                                    </span>
                                                </h6>
                                                <p>Clinically-proven results for anti-aging and skin
                                                    rejuvenation where the first signs of aging appear.</p>
                                            </div>
                                            <div class="include_pd-price">
                                                {% assign product = all_products['neck-decolletage-led'] %}
                                                <h6><del class="text-grey">{{ product.price | money_without_trailing_zeros }}</del> <span
                                                        class="green_txt">FREE</span></h6>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="include_checkout">
                                        <div class="row justify-content-between">
                                            <div class="col-auto">
                                                <p class="green_txt">INSTANT SAVINGS: {{ product_led_neck.price | money_without_trailing_zeros }}</p>
                                            </div>
                                            <div class="col-auto">
                                                <h6><del class="text-grey">{{ product_led_neck.price | plus: product_led_mask.price | money_without_trailing_zeros }}</del> <span>{{ product_led_mask.price | money_without_trailing_zeros }}</span></h6>
                                            </div>
                                        </div>

                                        <div class="include_stock">
                                            <p>Low Stock</p>
                                            <span>Due to high demand, this offer has limited
                                                availability.</span>
                                            <div class="row align-items-center">
                                                <div class="col-sm-10 col-9">
                                                    <div class="batch_h-info" style="--bgPercent:83%;"></div>
                                                </div>
                                                <div class="col-sm-2 col-3">
                                                    <h6>83% SOLD</h6>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="order_today">
                                            <p>Order today to lock in your deal and get <strong
                                                    class="d-block d-md-inline-block">FREE Shipping</strong></p>
                                        </div>
                                    </div>
                                    <!-- Buy Now Button -->
                                    <button class="buy-now" id="buy-now-button">Shop & Save {{ product_led_neck.price | money_without_trailing_zeros }}</button>

                                    <!-- Payment Methods -->
                                    <div class="payment_method">
                                        <p>or pay 4 monthly payments of {{ product_led_mask.price | divided_by: 4 | money_without_trailing_zeros }} with</p>
                                        <div class="pmt_img ps-2">
                                            <img src="https://qureskincaredns.com/new/assets/klarna.svg" alt="Klarna">
                                            <img src="https://qureskincaredns.com/new/assets/sezzle.svg" alt="Sezzle">
                                            <img src="https://qureskincaredns.com/new/assets/afterpay.svg" alt="Afterpay">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- product bundle end -->

<script>
    document.getElementById('buy-now-button').addEventListener('click', function() {
        
        let __discount = '';
        let __items = [];

        __items.push({
            id: 46181053858031,
            quantity: 1
        });

        __items.push({
            id: 44062187913455,
            quantity: 1
        });

        __discount = 'FREEN&DOFFER';

        if(__discount)
        {
            fetch('/discount/' + __discount).then(async () => {
                cartRequestAdd({ 
                    items:  __items
                }, {} )
            });
        }
        else
        {
            cartRequestAdd({ 
                items:  __items
            }, {} )
        }
    });

    document.addEventListener("DOMContentLoaded", function() {
        var swiper = new Swiper(".bfs_mb_sl", {
            spaceBetween: 0,
            slidesPerView: 4,
            watchSlidesProgress: true,
            breakpoints: {
                768: {
                    spaceBetween: 0,
                    slidesPerView: 4,
                },

            },
        });

        var swiper2 = new Swiper(".bfs_mb_sl2", {
            spaceBetween: 10,
            navigation: {
                nextEl: ".thumb-next",
                prevEl: ".thumb-prev",
            },
            thumbs: {
                swiper: swiper,
            },
        });
    });

    document.addEventListener("DOMContentLoaded", function() {
        let find = '$299';
        let replace = '{{ product_led_neck.price | money_without_trailing_zeros }}';
        const spanEl = document.querySelector('.header_btn span');
        
        if (spanEl && spanEl.textContent.includes(find)) {
            spanEl.textContent = spanEl.textContent.replace(find, replace);
        }

        document.querySelectorAll('a.btn-primary').forEach(aEl => {
            if (aEl.textContent.includes(find)) {
                aEl.textContent = aEl.textContent.replace(find, replace);
            }
        });
    });
</script>