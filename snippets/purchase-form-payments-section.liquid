{%- assign payment_type_count = 0 -%}

{%- for block in section.blocks -%}
    {% case block.type %}
        {% when 'payment_type' %}
            {%- assign payment_type_count = payment_type_count | plus: 1 -%}
    {% endcase %}
{% endfor %}

<style>
    .total_price .regular_price {
        font-size: 14px;
    }
    .total_price .sale_price, .price .pay_today {
        font-size: 17px;
    }
</style>

{% if payment_type_count > 0 %}
    <div class="supply_steps"{% if section.settings.hide_payment_types == true %} style="display:none"{% endif %}>
        <div class="step_counter">
            <span class="">{% if section.settings.hide_product_types == true %}2{% else %}3{% endif %}</span>
        </div>
        <div class="step_block">
            <div class="step_header">
                <h3 class="align-items-baseline"><span class="d-none">Step 3/3</span> Choose a payment option</h3>
            </div>
            <div class="step_content">
                {% assign num = 0 %}
                {%- for block in section.blocks -%}
                    {% case block.type %}
                        {% when 'payment_type' %}
                            {% if num == 0 %}
                                <div class="pmtBlock">
                                    <input type="radio" name="pmtPlan" id="pay_in_full" checked>
                                    <label class="pmt_plans" for="pay_in_full">
                                        <div class="pmt_des">
                                            {% if block.settings.heading != blank %}
                                                <div class="pmt_hdr">
                                                    <h3>{{ block.settings.heading }}</h3>
                                                </div>
                                            {% endif %}
                                            <div class="d-md-flex gap-2">
                                                <div class="pmt_des">{{ block.settings.text }}</div>
                                                {% if block.settings.image != blank %}
                                                    <div class="pmt_options"><img src="{{ block.settings.image | img_url: 'master' }}"  alt=""/></div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="price total_price">
                                            <div class="pmt_prc regular_price igComparePrice" data-product-id="8958518788335">$714</div>
                                            <div class="pmt_prc sale_price igPrice" data-product-id="8958518788335">$249</div>
                                        </div>
                                    </label>
                                </div>
                            {% else %}
                                <div class="pmtBlock">
                                    <input type="radio" name="pmtPlan" id="pay_today">
                                    <label class="pmt_plans" for="pay_today">
                                        <div class="pmt_des">
                                            {% if block.settings.heading != blank %}
                                                <div class="pmt_hdr">
                                                    <h3>{{ block.settings.heading }}</h3>
                                                </div>
                                            {% endif %}
                                            <div class="d-md-flex gap-2">
                                                <div class="pmt_des">{{ block.settings.text }}</div>
                                                {% if block.settings.image != blank %}
                                                    <div class="pmt_options"><img src="{{ block.settings.image | img_url: 'master' }}"  alt=""/></div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="price">
                                            <div class="pmt_prc pay_today igPrice" data-price-multiplier="0.25" data-product-id="8958518788335">$62.25</div>
                                        </div>
                                    </label>
                                </div>                                
                            {% endif %}
                            {%- assign num = num | plus: 1 -%}
                    {% endcase %}
                {% endfor %}                
            </div>
        </div>
    </div>
{% endif %}