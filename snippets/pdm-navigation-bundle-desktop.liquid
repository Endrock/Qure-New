{% comment %}
  Usage: {% render 'pdm-navigation-bundle-desktop', upsells_data: section.settings.upsell_content %}
{% endcomment %}

{% if upsells_data != blank %}
  <div class="pdm-upsell-nav-container-desktop">
    <div class="swiper pdm-upsell-nav-container__swiper">
      <div class="swiper-wrapper pdm-upsell-nav-container__swiper-wrapper">
        {% for item in upsells_data %}
          {% liquid
            assign show_product_title = item.show_product_title.value
            assign upsell_title = item.title.value

            assign show_product_image = item.show_product_image.value
            assign upsell_image = item.image.value

            assign upsell_product = item.product.value

            assign link_cta = item.link_cta.value
            assign go_to_product_link = item.go_to_product_link.value

            if show_product_title
              assign upsell_title = upsell_product.title
            endif

            if show_product_image or upsell_image == blank
              assign upsell_image = upsell_product.featured_image
            endif

            if go_to_product_link or link_cta == blank
              assign link_cta = upsell_product.url
            endif

          %}
          {% if link_cta != blank %}
            <div class="swiper-slide pdm-upsell-nav-container__swiper-slide">
              <a href="{{ link_cta }}" class="product-upsell-card">
                <div class="product-upsell-card__image-container">
                  {% if upsell_product.compare_at_price %}
                    {% assign discount_percentage = upsell_product.price
                      | times: 1.0
                      | divided_by: upsell_product.compare_at_price
                      | minus: 1
                      | abs
                      | times: 100
                      | ceil
                    %}
                    <span class="product-upsell-card__badge"> -{{ discount_percentage }}% </span>
                  {% endif %}
                  {% if upsell_image != blank %}
                    {{
                      upsell_image
                      | image_url: width: 640
                      | image_tag: alt: upsell_title, class: 'product-upsell-card__image'
                    }}
                  {% endif %}
                </div>
                <p>{{ upsell_title }}</p>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="swiper-button-next pdm-upsell-nav-container__swiper-button-next">
      <svg xmlns="http://www.w3.org/2000/svg" width="6" height="10" viewBox="0 0 6 10" fill="none">
        <path d="M0.5 8.77772L4.5 4.77772L0.5 1.22217" stroke="white" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="swiper-button-prev pdm-upsell-nav-container__swiper-button-prev">
      <svg xmlns="http://www.w3.org/2000/svg" width="6" height="10" viewBox="0 0 6 10" fill="none">
        <path d="M5.5 1.22228L1.5 5.22228L5.5 8.77783" stroke="white" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
{% endif %}
