{% unless page.handle == 'exclusive-holiday-bundle-deal-new' or page.handle == 'qure-microinfusion-offer' %}
  {{ 'rotating-announcement-bar.css' | asset_url | stylesheet_tag }}
  {{ 'splide.min.css' | asset_url | stylesheet_tag }}

  <div id="announcement-bar" class="announcement-bar" style="--ans-bar-font-size:16px; --anc-bar-font-weight :400;">
    <div class="announcement-container">
      <div class="splide" aria-label="Splide carousel">
        <div class="splide__track">
          <ul class="splide__list">
            {% for block in blocks %}
              {% if block.type == 'announcement_rotating' %}
                <li
                  class=" splide__slide announcement-bar-content text-center {% if forloop.first %}active{% endif %} {% if block.settings['button-label'] != blank %}has-button{%  endif %}"
                  data-index="{{ forloop.index0 }}"
                >
                  <a
                    class="announcement-bar-link"
                    {% if block.settings['button-url'] != blank -%}
                      href="{{ block.settings.button-url }}"
                    {%- endif %}
                  >
                    {% if block.settings.icon != blank -%}
                      <img
                        loading="lazy"
                        width="18"
                        height="18"
                        class="icon"
                        src="{{ block.settings.icon | image_url }}"

                        alt="{{ block.settings.icon.alt | escape }}"
                      >
                    {%- endif %}
                    <span>{{ block.settings.heading }}</span>
                    {% if block.settings['button-label'] != blank -%}
                      <div class="button" href="{{ block.settings.button-url }}">
                        {{ block.settings['button-label'] }}
                      </div>
                    {%- endif %}
                  </a>
                </li>
              {% endif %}
            {%- endfor %}
          </ul>
        </div>
        <div class="splide__arrows splide__arrows--ltr">
          <button
            class="splide__arrow splide__arrow--prev"
            type="button"
            aria-label="Previous slide"
            aria-controls="splide01-track"
          >
            {% render 'icon-arrow-right', class: 'arrow arrow-icon-left', id: 'prevButton' %}
          </button>
          <button
            class="splide__arrow splide__arrow--next"
            type="button"
            aria-label="Next slide"
            aria-controls="splide01-track"
          >
            {% render 'icon-arrow-right', class: 'arrow arrow-icon-right', id: 'nextButton' %}
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'splide.min.js' | asset_url  }}" defer></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const annoucement = document.querySelector('.announcement-bar .splide');
      const splide = new Splide(annoucement, {
        type: 'fade',
        rewind: true,
        focus: 'center',
        perPage: 1,
        perMove: 1,
        pauseOnHover: false,
        pagination: false,
        autoplay: true,
        interval:  {{ section.settings.delay }},
      });

      splide.mount();
    });
  </script>
{% endunless %}
