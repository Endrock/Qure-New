{%- assign out_of_stock_count = 0 -%}
{%- assign variant_count = 0 -%}
{%- assign show_out_of_stock = false -%}

{%- for block in section.blocks -%}
	{%- case block.type -%}
        {%- when 'out_of_stock' -%}
            {%- assign out_of_stock_count = out_of_stock_count | plus: 1 -%}
        {%- when 'variant' -%}
            {%- assign variant_count = variant_count | plus: 1 -%}

            {% unless block.settings.soldout %}
                {% if block.settings.variant_id == product.variants.first.id %}
                    {% if block.settings.reserve == true %}
                        {% assign show_out_of_stock = true %}
                    {% endif %}
                {% endif %}
            {% endunless %}
    {%- endcase -%}
{%- endfor -%}

<style>
    .out_of_stock {
        margin-top: 20px;
        {% if show_out_of_stock == true %}
        display: block;
        {% else %}   
        display:none;
        {% endif %}
    }
</style>


{% if out_of_stock_count > 0 %}
    <div class="next_batch_bl next_batch_highlight out_of_stock">
        {%- for block in section.blocks -%}
            {% if block.type == 'out_of_stock' %}
                {% if block.settings.heading != blank %}
                    <h6 class="d-none d-md-block">{{ block.settings.heading }}</h6>
                {% endif %}

                {% if block.settings.heading_mobile != blank %}
                    <h6 class="d-md-none">{{ block.settings.heading_mobile }}</h6>
                {% endif %}
                
                {% if block.settings.text != blank %}
                    {{ block.settings.text }}
                {% endif %}

                {% if block.settings.first_option_text != blank %}
                    <div class="batch_h batch_h_fade mt-3 mt-md-4">
                        <div class="batch_h_month">{{ block.settings.first_option_date }}</div>
                        <div class="batch_h_info sold_out_h" style="--bgPercent:{{ block.settings.first_option_percent }}%;"><span>{{ block.settings.first_option_text }}</span></div>
                    </div>
                {% endif %}

                {% if block.settings.second_option_text != blank %}
                    <div class="batch_h my-2">
                        <div class="batch_h_month">{{ block.settings.second_option_date }}</div>
                        <div class="batch_h_info" style="--bgPercent:{{ block.settings.second_option_percent }}%;">{{ block.settings.second_option_text }}</div>
                    </div>
                {% endif %}

                {% if block.settings.third_option_text != blank %}
                    <div class="batch_h batch_h_fade">
                        <div class="batch_h_month">{{ block.settings.third_option_date }}</div>
                        <div class="batch_h_info" style="--bgPercent:{{ block.settings.third_option_percent }}%;"><span>{{ block.settings.third_option_text }}</span></div>
                    </div>
                {% endif %}
            {% endif %}
        {%- endfor -%}
    </div>

    <script>
        function checkVariantInURL() {
            const targetDiv = document.querySelector('div.out_of_stock');
            const buttons = document.querySelectorAll('.btn_text_value');
            const buttons_sticky = document.querySelectorAll('.button_sticky');

            const text_soldout = 'Sold Out';
            const text_buynow = 'Buy Now';
            const text_reserve_now = 'Reserve Now';
            const text_subscribe_now = 'Subscribe Now';
            const text_add_to_bag = 'ADD TO BAG';

            const urlParams = new URLSearchParams(window.location.search);
            let variantParam = urlParams.get('variant');

            if(!variantParam)
            {
                variantParam = '{{ product.variants.first.id }}';
            }

            if (targetDiv) {
                {%- for block in section.blocks -%}
                    {%- case block.type -%}
                        {%- when 'variant' -%}
                                {% if block.settings.reserve == true %}
                                    if(variantParam === '{{ block.settings.variant_id }}')
                                    {
                                        {% if block.settings.soldout == true %}
                                            targetDiv.style.display = 'none';

                                            buttons.forEach(btn => {
                                                btn.textContent = text_soldout;
                                                btn.style.pointerEvents = 'none';
                                            });

                                            buttons_sticky.forEach(btn_s => {
                                                btn_s.textContent = text_soldout;
                                                btn_s.style.pointerEvents = 'none';
                                            });
                                        {% else %}
                                            targetDiv.style.display = 'block';

                                            buttons.forEach(btn => {
                                                btn.textContent = text_reserve_now;
                                                btn.style.pointerEvents = '';
                                            });

                                            buttons_sticky.forEach(btn_s => {
                                                btn_s.textContent = text_add_to_bag;
                                                btn_s.style.pointerEvents = '';
                                            });

                                        {% endif %}
                                    }
                                {% else %}
                                    if(variantParam === '{{ block.settings.variant_id }}')
                                    {
                                        targetDiv.style.display = 'none';

                                        {% if block.settings.soldout == true %}
                                            buttons.forEach(btn => {
                                                btn.textContent = text_soldout;
                                                btn.style.pointerEvents = 'none';
                                            });

                                            buttons_sticky.forEach(btn_s => {
                                                btn_s.textContent = text_soldout;
                                                btn_s.style.pointerEvents = 'none';
                                            });

                                        {% else %}
                                            buttons.forEach(btn => {
                                                if (btn.classList.contains('with_subscription')) {
                                                    btn.textContent = text_subscribe_now;
                                                } else {
                                                    btn.textContent = text_buynow;
                                                }
                                                btn.style.pointerEvents = '';
                                            });

                                            buttons_sticky.forEach(btn_s => {
                                                btn_s.textContent = text_add_to_bag;
                                                btn_s.style.pointerEvents = '';
                                            });
                                        {% endif %}
                                    }
                                {% endif %}
                    {%- endcase -%}
                {%- endfor -%}
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            checkVariantInURL();

            ['pushState', 'replaceState'].forEach(method => {
                const original = history[method];
                history[method] = function () {
                original.apply(this, arguments);
                checkVariantInURL();
                };
            });

            window.addEventListener('popstate', checkVariantInURL);
        });
    </script>    
{% endif %}