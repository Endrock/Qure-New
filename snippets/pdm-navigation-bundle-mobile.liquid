{% comment %}
  Usage:
  {% render 'pdm-navigation-bundle-mobile', upsells_data: section.settings.upsell_content %}
{% endcomment %}

{% assign bundle_content = upsells_data.upsell_list.value %}

{% if bundle_content != blank %}
  <div class="pdm-upsell-nav-container-mobile">
    <div class="swiper pdm-upsell-nav-container-mobile__swiper">
      <div class="swiper-wrapper pdm-upsell-nav-container-mobile__swiper-wrapper">
        {% for item in bundle_content %}
          {% liquid
            assign upsell_title = item.title.value
            assign upsell_image = item.image.value
            assign upsell_product = item.product.value
          %}
          <div class="swiper-slide pdm-upsell-nav-container-mobile__swiper-slide">
            <a href="{{ upsell_product.url }}" class="pdm-upsell-nav-container-mobile__card">
              <div class="pdm-upsell-nav-container-mobile__card__image-container">
                {% if upsell_product.compare_at_price %}
                  {% assign discount_percentage = upsell_product.price
                    | times: 1.0
                    | divided_by: upsell_product.compare_at_price
                    | minus: 1
                    | abs
                    | times: 100
                    | ceil
                  %}
                  <span class="pdm-upsell-nav-container-mobile__card__badge"> -{{ discount_percentage }}% </span>
                {% endif %}
                {{
                  upsell_image
                  | image_url: width: 100, height: 100
                  | image_tag: alt: upsell_title, class: 'pdm-upsell-nav-container-mobile__card__image'
                }}
              </div>
              <p>{{ upsell_title }}</p>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}
