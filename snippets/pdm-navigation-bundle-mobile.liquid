{% comment %}
  Usage:
  {% render 'pdm-navigation-bundle-mobile', upsells_data: section.settings.upsell_content %}
{% endcomment %}

{% assign bundle_content = upsells_data.bundle_item.value %}

<div class="pdm-upsell-nav-container-mobile">
  <div class="swiper pdm-upsell-nav-container-mobile__swiper">
    <div class="swiper-wrapper pdm-upsell-nav-container-mobile__swiper-wrapper">
      {% for item in bundle_content %}
        <div class="swiper-slide pdm-upsell-nav-container-mobile__swiper-slide">
          <a href="{{ item.url }}" class="pdm-upsell-nav-container-mobile__card">
            <div class="pdm-upsell-nav-container-mobile__card__image-container">
              {% if item.compare_at_price %}
                {% assign discount_percentage = item.price
                  | times: 1.0
                  | divided_by: item.compare_at_price
                  | minus: 1
                  | abs
                  | times: 100
                  | ceil
                %}
                <span class="pdm-upsell-nav-container-mobile__card__badge"> -{{ discount_percentage }}% </span>
              {% endif %}
              {{
                item.featured_image
                | image_url: width: 100, height: 100
                | image_tag: alt: item.title, class: 'pdm-upsell-nav-container-mobile__card__image'
              }}
            </div>
            <p>{{ item.title }}</p>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
