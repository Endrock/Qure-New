{% if input != blank %}
    {% assign included_json = input.value | parse_json %}

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button{% if index != 'first' %} collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ index }}" aria-expanded="true" aria-controls="accFAQOne">
                <div class="container">
                <p class="fw-normal">{{ title }} {% if mobile_title != blank %}<span class="d-none">{{ mobile_title }}</span>{% endif %}</p>
                </div>
            </button>

        </h2>
        <div id="{{ index }}" class="accordion-collapse collapse{% if index == 'first' %} show{% endif %}" data-bs-parent="#accordion_shower_filter" style="">
            <div class="accordion-body">
                <div class="container">
                  {% for item in included_json.children %}
                    {% case item.type %}
                      
                      {% when 'list' %}
                        <ul>
                          {% for list_item in item.children %}
                            <li>{{ list_item.children[0].value }}</li>
                          {% endfor %}
                        </ul>
                  
                      {% when 'paragraph' %}
                        <p>
                          {% for paragraph_item in item.children %}
                            {{ paragraph_item.value }}
                          {% endfor %}
                        </p>
                  
                    {% endcase %}
                  {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endif %}