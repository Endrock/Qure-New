{% liquid
  assign product_bundle = bundle_metafield_data.product_bundle.value
  assign normal_product = bundle_metafield_data.product_with_discount.value

  assign normal_product_discount = normal_product.price | times: bundle_metafield_data.discount_percent | divided_by: 100
  assign product_with_discount = normal_product.price | minus: normal_product_discount
%}

<pdm-bundle-upsell
  data-product-bundlet-id="{{ product_bundle.id }}"
  data-product-bundle-variant-id="{{ product_bundle.variants.first.id }}"
  data-product-bundle-handle="{{ product_bundle.handle }}"
  class="pdm_product-bundle-container {{ device_visibility }}"
>
  <label class="pdm_product-bundle-label">
    <input type="checkbox" name="product_bundle" value="{{ product_bundle.variants.first.id }}" class="hidden-checkbox">
    <span class="pdm_custom-checkbox"></span>
    <div class="pdm_product-bundle-content">
      <div class="pdm_product-bundle-content_info">
        <h3>{{ product_bundle.description }}</h3>
        <div class="pdm_product-bundle-price">
          <p class="pdm_product-bundle-price__save">
            {{ bundle_metafield_data.discount_text }}
            {{ normal_product_discount | money_without_trailing_zeros }}
          </p>
          <span class="pdm_product-bundle-price__full"> {{ normal_product.price | money_without_trailing_zeros }}</span>
          <span class="pdm_product-bundle-price__discount">
            {{ product_with_discount | money_without_trailing_zeros -}}
          </span>
        </div>
      </div>
      <div class="pdm_product-bundle-content_image">
        <div class="pdm_product-bundle-content_image__bundle">
          {{ normal_product.featured_image | image_url: width: 400 | image_tag: alt: normal_product.title }}
        </div>
      </div>
    </div>
  </label>
</pdm-bundle-upsell>
