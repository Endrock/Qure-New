            slidesPerView: 2.9,
            autoplay: {
                delay: 2000,
                disableOnInteraction: false,
            },
            loop: true,
            breakpoints: {
                640: {
                    slidesPerView: 3.5,
                    spaceBetween: 20,
                },
                768: {
                    slidesPerView: 5,
                    spaceBetween: 20,
                    touchRatio: 0
                }
            },
        });

        var swiper_press2 = new Swiper(".app_press_sl_content", {
            spaceBetween: 10,
            autoplay: {
                delay: 2000,
                disableOnInteraction: false,
            },
            loop: true,
            thumbs: {
                swiper: swiper_press,
            },
        });

        $('.thumbs img').click(function () {
            $('.largeImage').attr('src', $(this).attr('src').replace('thumb', 'large'));
            $(this).addClass('current').siblings().removeClass('current');
        });


        const tabs = document.querySelectorAll('#pills-tab-skin .nav-link');

        tabs.forEach(tab => {
            tab.addEventListener('show.bs.tab', function (event) {
                const targetId = event.target.getAttribute('data-bs-target');
                const targetPane1 = document.querySelector(`#pills-tabContent1 ${targetId}`);
                const targetPane2 = document.querySelector(`#pills-tabContent2 ${targetId.replace('1', '2')}`);

                document.querySelectorAll('#pills-tabContent1 .tab-pane').forEach(pane => {
                    pane.classList.remove('show', 'active');
                });
                document.querySelectorAll('#pills-tabContent2 .tab-pane').forEach(pane => {
                    pane.classList.remove('show', 'active');
                });

                if (targetPane1) {
                    targetPane1.classList.add('show', 'active');
                }
                if (targetPane2) {
                    targetPane2.classList.add('show', 'active');
                }
            });
        });



        // Initialize thumbnail Swiper first
        const thumbSwiper = new Swiper(".thumb_swiper", {
            spaceBetween: 10,
            slidesPerView: 'auto', // Ensures thumb slides are scrollable
            freeMode: true,
            watchSlidesProgress: true,
            navigation: {
                nextEl: '.thumb-next',
                prevEl: '.thumb-prev',
            }
        });

        // Then main image Swiper, and link thumbs
        const mainSwiper = new Swiper(".main_image_swiper", {
            spaceBetween: 10,
            navigation: {
                nextEl: '.thumb-next',
                prevEl: '.thumb-prev',
            },
            thumbs: {
                swiper: thumbSwiper,
            },
            pagination: {
                el: ".swiper-pagination",
                type: "fraction", // Optional, only if needed
            },
        });



        const tooltipButtons = document.querySelectorAll('.tooltip_btn');

        tooltipButtons.forEach(btn => {
            const tooltip = btn.querySelector('.tooltip_info');

            btn.addEventListener('click', function (e) {
                // Prevent bubbling to avoid unwanted closings
                e.stopPropagation();

                // Close other tooltips
                document.querySelectorAll('.tooltip_info').forEach(t => {
                    if (t !== tooltip) t.classList.remove('visible');
                });

                // Toggle this one
                tooltip.classList.toggle('visible');
            });
        });

        // Close tooltip if clicked outside
        document.addEventListener('click', function () {
            document.querySelectorAll('.tooltip_info').forEach(t => t.classList.remove('visible'));
        });


        const skinSlider = new Swiper('#twa__swiper-skinSlider', {
            slidesPerView: 1,
            spaceBetween: 30,
            loop: false,
            centeredSlides: true,
            pagination: {
                el: '.swiper-pagination',
                type: 'fraction',
                renderFraction: function (currentClass, totalClass) {
                return '<span class="' + currentClass + '"></span>' +
                        ' / ' +
                        '<span class="' + totalClass + '"></span>';
                }
            },
            navigation: {
                nextEl: '.skinSlider-swiper-next',
                prevEl: '.skinSlider-swiper-prev',
            },
            breakpoints: {
                768: { slidesPerView: 1.2 },
                992: { slidesPerView: 2 }
            }
        });
    });

    function toggleDropdown() {
        const options = document.getElementById("dropdownOptions");
        options.classList.toggle("d-none");
    }

    function selectColor(color) {
        const selected = document.querySelector(".dropdown_selected span:nth-child(2)");
        selected.textContent = color;

        const swatch = document.querySelector(".dropdown_selected .circle_swatch");
        swatch.className = `circle_swatch ${color.toLowerCase()}_swatch`;

        toggleDropdown(); // close dropdown
    }

</script>

