<link rel="stylesheet" href="{{ 'product-mi-landing.css' | asset_url }}">

{% include 'assoc-array', section: section, __parent_title: 'type', __separator: '###' %}

{%- for block in section.blocks -%}
    {% case block.type %}
        {% when 'line' %}
            <div class="available_bar"{% if block.settings.background != blank %} style="background: {{ block.settings.background }};"{% endif %}>
                <p>{{ block.settings.text }}</p>
            </div>
    {% endcase %}
{% endfor %}

<!-- new treatment section  -->
<div class="section productSubscription choose_serum new_updated_treatment_outer {{ section.id }}" id="productSubscription">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="qure__treatments">
                    <div class="text-start order-2 order-md-1">
                        <div class="section__header d-none d-md-block">
                            {% if section.settings.heading != blank %}
                                <h2 class="title-lg">{{ section.settings.heading }}</h2>
                            {% endif %}
                            <div class="des">
                                {% if section.settings.text != blank %}
                                    {{ section.settings.text }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="tmtFtrs_image order-1 order-md-2">
                        <div class="section__header d-block d-md-none">
                            {% if section.settings.heading != blank %}
                                <h2 class="title-lg">{{ section.settings.heading }}</h2>
                            {% endif %}
                            <div class="des">
                                {% if section.settings.text != blank %}
                                    {{ section.settings.text }}
                                {% endif %}
                            </div>
                        </div>
                        {% if section.settings.image != blank %}
                            <img src="{{ section.settings.image | img_url: 'master' }}" class="img-fluid" alt="choosen_image" id="choosen_image" />
                        {% endif %}
                    </div>
                    <div class="tmtFtrs d-none d-md-flex justify-content-between mb-4 mt-5 mw-455">
                        {% if section.settings.icon_image1 != blank %}
                            <div class="tmtFtrs_block text-center"> 
                                <div class="tmtFtr_icon">
                                    <img src="{{ section.settings.icon_image1 | img_url: 'master' }}" alt="">
                                </div>
                                {% if section.settings.icon_text1 != blank %}
                                    <div class="tmtFtr_des">
                                        {{ section.settings.icon_text1 }}
                                    </div>                    
                                {% endif %}
                            </div>             
                        {% endif %}

                        {% if section.settings.icon_image2 != blank %}
                            <div class="tmtFtrs_block text-center"> 
                                <div class="tmtFtr_icon">
                                    <img src="{{ section.settings.icon_image2 | img_url: 'master' }}" alt="">
                                </div>
                                {% if section.settings.icon_text2 != blank %}
                                    <div class="tmtFtr_des">
                                        {{ section.settings.icon_text2 }}
                                    </div>                    
                                {% endif %}
                            </div>             
                        {% endif %}

                        {% if section.settings.icon_image3 != blank %}
                            <div class="tmtFtrs_block text-center"> 
                                <div class="tmtFtr_icon">
                                    <img src="{{ section.settings.icon_image3 | img_url: 'master' }}" alt="">
                                </div>
                                {% if section.settings.icon_text3 != blank %}
                                    <div class="tmtFtr_des">
                                        {{ section.settings.icon_text3 }}
                                    </div>                    
                                {% endif %}
                            </div>             
                        {% endif %}
                    </div>
                    {% if section.settings.bottom_text != blank %}
                        <div class="qst_box text-center d-none d-md-block">
                            <img src="https://qureskincaredns.com/new/assets/question_mark.svg" alt="question_mark" class="me-2">{{ section.settings.bottom_text | replace: '<p>', '' | replace: '</p>', '' }}
                        </div>        
                    {% endif %}
                </div>
            </div>
            <div class="col-md-6 p-0 pt-md-5">
                <div class="supply-detail offer_active">
                    {% render 'purchase-form-types-section' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
                    {% render 'purchase-form-products-section' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
                    {% render 'purchase-form-payments-section' section: section %}
                    <div class="supply_steps">
                        <div class="step_counter" style="visibility: collapse;"><span class="">&nbsp;</span></div>
                        <div class="step_block">
                            <div class="step_content mb-0 pt-0 pb-1 step_btn">
                                <a href="javascript:void(0)" class="btn btn-atc submit_btn productButtonObject" data-ajax-cart-request-button>
                                    <span class="btn_value">Buy Now</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="c_s_shipping d-block d-md-none mt-3">
                        <div class="c_s_wrapper">
                            {% if section.settings.icon_image1 != blank %}
                                <div class="c_s_bx">
                                    <img src="{{ section.settings.icon_image1 | img_url: 'master' }}" alt="">
                                    {% if section.settings.icon_text1 != blank %}
                                        <p>{{ section.settings.icon_text1 }}</p>
                                    {% endif %}
                                </div> 
                            {% endif %}

                            {% if section.settings.icon_image2 != blank %}
                                <div class="c_s_bx">
                                    <img src="{{ section.settings.icon_image2 | img_url: 'master' }}" alt="">
                                    {% if section.settings.icon_text2 != blank %}
                                        <p>{{ section.settings.icon_text2 }}</p>
                                    {% endif %}
                                </div> 
                            {% endif %}

                            {% if section.settings.icon_image3 != blank %}
                                <div class="c_s_bx">
                                    <img src="{{ section.settings.icon_image3 | img_url: 'master' }}" alt="">
                                    {% if section.settings.icon_text3 != blank %}
                                        <p>{{ section.settings.icon_text3 }}</p>
                                    {% endif %}
                                </div> 
                            {% endif %}
                        </div>
                        {% if section.settings.bottom_text != blank %}
                            <div class="c_s_ques text-center">
                                <p class="ask-ques">
                                    <img src="https://qureskincaredns.com/new/assets/question_mark.svg" alt="">{{ section.settings.bottom_text | replace: '<p>', '' | replace: '</p>', '' }}
                                </p>
                            </div>            
                        {% endif %}
                    </div>
                </div> 
            </div>
        </div>
    </div>
</div>
<!-- new treatment section end  -->

<script>var purchase_form_section_id = '{{ section.id }}';</script>
<script src="{{ '__app-purchase-form.js' | asset_url }}" defer></script>

{%- schema -%}
{
    "name":"t:sections.purchase-form.name",
    "class":"purchase-form mi_landing mi_lp mi_lp_v2",
    "settings":[
        {
            "type": "text",
            "id": "heading",
            "label": "t:common.heading.label"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text.label"
        },
        {
            "type": "checkbox",
            "id": "hide_product_types",
            "label": "t:sections.purchase-form.settings.hide_product_types",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "hide_payment_types",
            "label": "t:sections.purchase-form.settings.hide_payment_types",
            "default": false
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image1",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text1",
            "label": "t:common.text.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image2",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text2",
            "label": "t:common.text.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image3",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text3",
            "label": "t:common.text.label"
        },
        {
            "type": "richtext",
            "id": "bottom_text",
            "label": "t:common.text.label"
        }
    ],
    "blocks":[
        {
            "type": "line",
            "name": "t:sections.purchase-form.blocks.line.name",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:sections.purchase-form.blocks.line.settings.text",
                    "default": "SOLD OUT 10X - AVAILABLE UNTIL STOCK LASTS"
                },
                {
                    "type": "color_background",
                    "id": "background",
                    "label": "t:sections.purchase-form.blocks.line.settings.background"
                }
            ]
        },
        {
            "type": "preorder_box",
            "name": "t:sections.purchase-form.blocks.preorder_box.name",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.heading.label"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text.label"
                },
                {
                    "type": "header",
                    "content": "First option"
                },
                {
                    "type": "text",
                    "id": "first_option_date",
                    "label": "t:common.date.label",
                    "default": "October 15th"
                },
                {
                    "type": "text",
                    "id": "first_option_text",
                    "label": "t:common.text.label",
                    "default": "SOLD OUT"
                },
                {
                    "type": "range",
                    "id": "first_option_percent",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "label": "t:common.percent.label",
                    "default": 100
                },
                {
                    "type": "header",
                    "content": "Second option"
                },
                {
                    "type": "text",
                    "id": "second_option_date",
                    "label": "t:common.date.label",
                    "default": "November 10th"
                },
                {
                    "type": "text",
                    "id": "second_option_text",
                    "label": "t:common.text.label",
                    "default": "81% Reserved"
                },
                {
                    "type": "range",
                    "id": "second_option_percent",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "label": "t:common.percent.label",
                    "default": 81
                },
                {
                    "type": "header",
                    "content": "Third option"
                },
                {
                    "type": "text",
                    "id": "third_option_date",
                    "label": "t:common.date.label",
                    "default": "December 30th"
                },
                {
                    "type": "text",
                    "id": "third_option_text",
                    "label": "t:common.text.label",
                    "default": "In Production"
                },
                {
                    "type": "range",
                    "id": "third_option_percent",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "label": "t:common.percent.label",
                    "default": 0
                }
            ]
        },
        {
            "type": "type",
            "limit": 3,
            "name": "t:sections.purchase-form.blocks.type.name",
            "settings": [
                {
                    "type": "header",
                    "content": "TYPE"
                }
            ]
        },
        {
            "type": "product_type",
            "name": "t:sections.purchase-form.blocks.product_type.name",
            "limit": 3,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.heading.label"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image.label"
                },
                {
                    "type": "checkbox",
                    "id": "preselected",
                    "label": "t:sections.purchase-form.blocks.product_type.settings.preselected",
                    "default": false
                }
            ]
        },
        {
            "type": "product",
            "name": "t:sections.purchase-form.blocks.product.name",
            "limit": 9,
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "t:common.product.label"
                },   
                {
                    "type": "checkbox",
                    "id": "preselected",
                    "label": "t:sections.purchase-form.blocks.product.settings.preselected",
                    "default": false
                },             
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.heading.label"
                },
                {
                    "type": "text",
                    "id": "subheading",
                    "label": "t:common.text.label"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image.label"
                },
                {
                    "type": "number",
                    "id": "left_items",
                    "label": "t:sections.purchase-form.blocks.product.settings.left_items"
                },
                {
                    "type": "checkbox",
                    "id": "reserve",
                    "label": "t:common.reserve.label",
                    "default": false
                },
                {
                    "type": "checkbox",
                    "id": "soldout",
                    "label": "t:common.soldout.label",
                    "default": false
                },
                {
                    "type": "checkbox",
                    "id": "preorder",
                    "label": "t:common.preorder.label",
                    "default": false
                },
                {
                    "type": "richtext",
                    "id": "preorder_text",
                    "label": "t:sections.purchase-form.blocks.product.settings.preorder_text"
                },
                {
                    "type": "text",
                    "id": "preorder_date_soldout",
                    "label": "t:sections.purchase-form.blocks.product.settings.preorder_date_soldout"
                },
                {
                    "type": "text",
                    "id": "preorder_date_reserved",
                    "label": "t:sections.purchase-form.blocks.product.settings.preorder_date_reserved"
                },
                {
                    "type": "text",
                    "id": "preorder_percent",
                    "label": "t:sections.purchase-form.blocks.product.settings.preorder_percent"
                },
                {
                    "type": "richtext",
                    "id": "included_text",
                    "label": "t:sections.purchase-form.blocks.product.settings.included_text"
                }
            ]
        },
        {
            "type": "payment_type",
            "name": "t:sections.purchase-form.blocks.payment_type.name",
            "limit": 2,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.heading.label"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:common.text.label"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image.label"
                }
            ]
        },
    ],
    "presets":[
        {
            "name":"t:sections.purchase-form.name"
        }
    ]
}
{%- endschema -%}