                },
                {
                    "type": "text",
                    "id": "subheading",
                    "label": "t:common.text.label"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:common.image.label"
                },
                {
                    "type": "number",
                    "id": "left_items",
                    "label": "t:sections.purchase-form.blocks.product.settings.left_items"
                },
                {
                    "type": "checkbox",
                    "id": "reserve",
