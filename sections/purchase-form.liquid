                    "label": "t:common.preorder.label",
                    "default": false
                },
                {
                    "type": "checkbox",
                    "id": "soldout",
                    "label": "t:common.soldout.label",
                    "default": false
                },
                {
                    "type": "checkbox",
                    "id": "show_soldout",
                    "label": "t:sections.purchase-form.blocks.product.settings.show_soldout",
                    "default": false
                },
                {
                    "type": "richtext",
                    "id": "included_text",
                    "label": "t:sections.purchase-form.blocks.product.settings.included_text"
                }
            ]
        },
        {
            "type": "payment_type",
            "name": "t:sections.purchase-form.blocks.payment_type.name",
            "limit": 2,
            "settings": [
                {
                    "type": "text",
