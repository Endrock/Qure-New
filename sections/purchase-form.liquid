            "label": "t:common.heading.label"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:common.text.label"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:common.image.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image1",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text1",
            "label": "t:common.text.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image2",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text2",
            "label": "t:common.text.label"
        },
        {
            "type": "image_picker",
            "id": "icon_image3",
            "label": "t:common.image.label"
        },
        {
            "type": "text",
            "id": "icon_text3",
            "label": "t:common.text.label"
        },
        {
            "type": "richtext",
            "id": "bottom_text",
            "label": "t:common.text.label"
        }
    ],
    "blocks":[
        {
            "type": "line",
            "name": "t:sections.purchase-form.blocks.line.name",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:sections.purchase-form.blocks.line.settings.text",
                    "default": "SOLD OUT 10X - AVAILABLE UNTIL STOCK LASTS"
                },
                {
                    "type": "color_background",
                    "id": "background",
                    "label": "t:sections.purchase-form.blocks.line.settings.background"
                }
            ]
        },
        {
            "type": "out_of_stock",
            "name": "t:common.out_of_stock.label",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "t:common.heading.label"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:common.text.label"
                },
                {
                    "type": "header",
                    "content": "First option"
                },
                {
                    "type": "text",
                    "id": "first_option_date",
                    "label": "t:common.date.label",
                    "default": "October 15th"
                },
                {
                    "type": "text",
                    "id": "first_option_text",
                    "label": "t:common.text.label",
                    "default": "SOLD OUT"
                },
                {
                    "type": "range",
                    "id": "first_option_percent",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "label": "t:common.percent.label",
                    "default": 100
                },
                {
                    "type": "header",
                    "content": "Second option"
                },
                {
                    "type": "text",
                    "id": "second_option_date",
                    "label": "t:common.date.label",
                    "default": "November 10th"
                },
                {
                    "type": "text",
                    "id": "second_option_text",
                    "label": "t:common.text.label",
                    "default": "81% Reserved"
                },
                {
                    "type": "range",
                    "id": "second_option_percent",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "label": "t:common.percent.label",
                    "default": 81
                },
                {
                    "type": "header",
                    "content": "Third option"
                },
                {
                    "type": "text",
                    "id": "third_option_date",
