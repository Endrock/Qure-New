

<div class="container">
  <div class="d-md-flex justify-content-between align-items-center">
    <div class="proof_in_num mw-500 text-center text-md-left mb-4 mb-md-0">
      <h2 class="title-lg">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="user_report_wrap p-0">
      {% for block in section.blocks %}
        {% assign percent = block.settings.percentage %}
        {% assign offset = 100 | minus: percent %}
        <div class="progressCont">
          <span class="progressWrapper">
            <span class="progessInfo text-dark">{{ percent }}%</span>
            <svg class="vMQQx" height="83" width="83" viewBox="-29 -29 58 58">
              <defs>
                <linearGradient id="gradient" x1="0" x2="0" y1="1" y2="0">
                  <stop offset="0%" stop-color="#C7E7DC"></stop>
                  <stop offset="100%" stop-color="#C7E7DC"></stop>
                </linearGradient>
              </defs>
              <circle stroke="rgba(221, 224, 228, 1)" fill="none" pathLength="100" class="K4v4P" r="24" style="stroke-width: 1px;"></circle>
              <circle visibility="visible" fill="none" pathLength="100" transform="rotate(-90)" class="OKwUu" r="24" stroke="url(#gradient)" style="stroke-dasharray: 100; stroke-dashoffset: {{ offset }}; stroke-width: 5px;"></circle>
            </svg>
          </span>
          <div class="tooltip_wrap">
            <div class="tooltip_btn">
              <div class="tootltip_text">
                {{ block.settings.main_text }}
                <img src="https://qureskincaredns.com/new/assets/info_lg.svg" alt="">
                <div class="tooltip_info">
                  <img src="https://qureskincaredns.com/new/assets/tooltip_triangle.svg" alt="">
                  <p>{{ block.settings.tooltip_text }}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>



{% schema %}
{
  "name": "Proof In Numbers",
  "tag": "section",
  "class": "user_report bg-lightGrey section ctm_cls_led_mask_progress",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Proof In Numbers"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "During clinical studies on LED light therapy, users reported numerous benefits:"
    }
  ],
  "blocks": [
    {
        "type": "report_item",
        "name": "Report Item",
        "settings": [
          {
            "type": "number",
            "id": "percentage",
            "label": "Percentage",
            "default": 87
          },
          {
            "type": "richtext",
            "id": "main_text",
            "label": "Main Text",
            "default": "reported smoother facial wrinkles and fine lines"
          },
          {
            "type": "richtext",
            "id": "tooltip_text",
            "label": "Tooltip Text",
            "default": "Clinical trial was conducted to assess reduction in sun damage signs following 12 weeks of LED therapy..."
          }
        ]
      }
  ],
  "presets": [
    {
      "name": "Proof In Numbers",
      "category": "Custom",
      "blocks": [
        {
          "type": "report_item",
          "settings": {
            "percentage": 87,
            "main_text": "reported smoother facial wrinkles and fine lines",
            "tooltip_text": "Clinical trial was conducted to assess reduction in sun damage signs following 12 weeks of LED therapy..."
          }
        },
        {
          "type": "report_item",
          "settings": {
            "percentage": 91,
            "main_text": "reported improved skin tone and enhanced smoothness",
            "tooltip_text": "Clinical trial conducted with acne-grade patients alternating blue and near-IR light. Results assessed over 8 weeks."
          }
        },
        {
          "type": "report_item",
          "settings": {
            "percentage": 83,
            "main_text": "reported a reduction in acne breakouts",
            "tooltip_text": "Clinical trial with 660nm LED light. Results assessed in aged/photoaged individuals in a split-face study."
          }
        }
      ]
    }
  ]
}
{% endschema %}