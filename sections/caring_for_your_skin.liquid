<!-- caring-for-your-skin.liquid -->
<h2>{{ section.settings.heading }}</h2>

{% schema %}
{
  "name": "Caring for your skin",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hello from custom section"
    }
  ],
  "presets": [
    {
      "name": "Caring for your skin"
    }
  ]
}
{% endschema %}
