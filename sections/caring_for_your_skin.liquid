{% schema %}
{
  "name": "Caring for Your Skin",
  "tag": "section",
  "class": "caring_for_your_skin",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Caring for your skin & hair just got easier"
    },
    {
      "type": "richtext",
      "id": "para1",
      "label": "Paragraph 1",
      "default": "<p>We know it can be hard to remember exactly when to switch out filters. Our convenient subscription plan ensures your replacement filter arrives at your doorstep at just the right time.</p>"
    },
    {
      "type": "richtext",
      "id": "para2",
      "label": "Paragraph 2",
      "default": "<p>No need to wonder, no need to guess. Just pure, perfectly optimized water for your skin and hair. Set it and forget it!</p>"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image",
      "default": "https://qureskincaredns.com/new/assets/caring_skin.webp"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image",
      "default": "https://qureskincaredns.com/new/assets/caring_skin_mob.webp"
    }
  ],
  "blocks": [
    {
      "type": "icon_feature",
      "name": "Icon Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Caring for Your Skin",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "icon_feature",
          "settings": {
            "icon": "https://qureskincaredns.com/new/assets/ninety_day_supply_icon.svg",
            "text": "90-day supply"
          }
        },
        {
          "type": "icon_feature",
          "settings": {
            "icon": "https://qureskincaredns.com/new/assets/easy_replacement.svg",
            "text": "Easy replacement"
          }
        },
        {
          "type": "icon_feature",
          "settings": {
            "icon": "https://qureskincaredns.com/new/assets/cancel_anytime.svg",
            "text": "Cancel anytime"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="container">
  <div class="row">
    <div class="col-md-7">
      <div class="caring_skin mw-542">
        <h3>{{ section.settings.heading }}</h3>
        {{ section.settings.para1 }}
        {{ section.settings.para2 }}
        <div class="supply_icons d-none d-md-flex flex-wrap">
          {% for block in section.blocks %}
            {% if block.type == 'icon_feature' %}
              <div class="ninety_easy_icons">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | image_url }}" alt="">
                {% endif %}
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <div class="caring_skin_img d-flex justify-content-between gap-2 d-md-block align-items-center">
        {% if section.settings.image_desktop %}
          <img src="{{ section.settings.image_desktop | image_url }}" alt="" class="img-fluid d-none d-md-block skin_care_img">
        {% endif %}
        {% if section.settings.image_mobile %}
          <img src="{{ section.settings.image_mobile | image_url }}" alt="" class="img-fluid d-md-none skin_care_img">
        {% endif %}
        <div class="supply_icons d-md-none flex-wrap">
          {% for block in section.blocks %}
            {% if block.type == 'icon_feature' %}
              <div class="ninety_easy_icons">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | image_url }}" alt="">
                {% endif %}
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- Static portion: Can be enhanced later -->
      <div class="subscribe_save_wrapper with_subscription mt-2">
        <div class="subscribeTopInfo">
          <p class="px-md-5">MOST POPULAR CHOICE</p>
        </div>
        <div class="subscriptionType active" data-subscription="subscription">
          <div class="subscribe_save_bx d-block">
            <div class="subscribeInfo">
              <label class="form-check-label" for="flexCheckDefault">
                <div class="row justify-content-between">
                  <div class="col-md-8 col-6 pe-0">
                    <h6>Subscribe &amp; save 30%</h6>
                  </div>
                  <div class="col-md-4 col-6">
                    <div class="subscribePrice">
                      <p><span>$50</span>$35</p>
                    </div>
                  </div>
                  <div class="col-md-10">
                    <p class="subscribe_txt pe-2">Get a new replacement filter delivered every 90 days for just $35. Skip or cancel at any time. <a href="#">See more details</a></p>
                  </div>
                </div>
              </label>
            </div>
          </div>
        </div>
        <div class="subscriptionType" data-subscription="no-subscription">
          <a class="btn btn-lg btn-primary without_subscription buy_btn" href="#productSubscription">Buy Now</a>
          <div class="payment_method without_subscription">
            <p>OR pay 4 monthly payments of $12.50 with</p>
            <div class="pmt_img ps-2">
              <img src="https://qureskincaredns.com/new/assets/klarna.svg" alt="">
              <img src="https://qureskincaredns.com/new/assets/sezzle.svg" alt="">
              <img src="https://qureskincaredns.com/new/assets/afterpay.svg" alt="">
            </div>
          </div>
        </div>
        <a class="btn btn-lg btn-primary with_subscription buy_btn mt-2" href="#productSubscription">Subscribe Now</a>
      </div>
    </div>
  </div>
</div>
