<!-- Meet Qure Shower Filter -->
<div class="container">
  <div class="row align-items-center">
    <div class="col-lg-5 mb-4 mb-lg-0">
      <div class="meet_shower_filter_img">
        {% if section.settings.main_image %}
          <img src="{{ section.settings.main_image | image_url: width: 600 }}" alt="Qure Shower Filter" class="img-fluid">
        {% endif %}
      </div>
    </div>
    <div class="col-lg-7">
      <div class="meet_shower_filter_content ps-md-5">
        <h2 class="title-lg pb-2">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
        <div class="row water_filter_feature_icons mt-md-4 mt-3 gy-md-4 gy-2">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="col-6 d-flex align-items-center mb-2 pe-0">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | image_url: width: 30 }}" alt="" class="img-fluid me-2">
                {% endif %}
                <span>{{ block.settings.label }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <div class="d-md-none ctm_cls_filter_wat">
            <a class="btn btn-lg btn-primary with_subscription mt-4 d-md-none" href="{{ section.settings.button_link }}">
              {{ section.settings.button_text }}
            </a>

            <div class="bg-transparent ctm_cls_shipping d-flex mw-359 px-4 mx-auto pt-3 shipping shipping_bg">
              {% if section.settings.shipping_icon %}
                <div class="s_bx">
                  <img src="{{ section.settings.shipping_icon | image_url: width: 40 }}" alt="">
                  <p>{{ section.settings.shipping_text }}</p>
                </div>
              {% endif %}
              {% if section.settings.pay_later_icon %}
                <div class="s_bx">
                  <img src="{{ section.settings.pay_later_icon | image_url: width: 40 }}" alt="">
                  <p>{{ section.settings.pay_later_text }}</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<!-- Meet Qure Shower Filter end -->

{% schema %}
{
  "name": "Meet Qure Shower Filter",
  "tag": "section",
  "class": "meet_qure_shower_filter section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Qure Shower Filter"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Qure, we believe great skin starts at the source – and that’s the water you use every day. The Qure Shower Filter helps remove sneaky chemicals and minerals that live in your water and linger on your skin."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Buy Button Text",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Buy Now Button Link"
    },
    {
      "type": "image_picker",
      "id": "shipping_icon",
      "label": "Shipping Icon"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "Free Shipping <br>Orders Over $100"
    },
    {
      "type": "image_picker",
      "id": "pay_later_icon",
      "label": "Buy Now Pay Later Icon"
    },
    {
      "type": "text",
      "id": "pay_later_text",
      "label": "Buy Now Pay Later Text",
      "default": "Buy Now,<br> Pay Later"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Filters Heavy Metals"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Meet Qure Shower Filter",
      "category": "Custom",
      "blocks": [
        { "type": "feature", "settings": { "label": "Filters Heavy Metals" } },
        { "type": "feature", "settings": { "label": "Removes Chlorine" } },
        { "type": "feature", "settings": { "label": "Reduces Build-Up" } },
        { "type": "feature", "settings": { "label": "Balances pH" } },
        { "type": "feature", "settings": { "label": "Boosts Skin Hydration" } },
        { "type": "feature", "settings": { "label": "Locks in Hair Moisture" } }
      ]
    }
  ]
}
{% endschema %}
