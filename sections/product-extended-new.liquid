<style>
    .subscribe_save_wrapper .subscribe_save_bx {
        grid-template-columns: 67% 33%;
    }
    .button_sticky_wrapper .button_sticky {
        font-size: 13px !important;
    }
    button.with_subscription {
        font-size: 22px !important;
        font-weight: 600 !important;
    }
</style>

{%- assign rating_count = 0 -%}
{%- assign list_count = 0 -%}
{%- assign supply_count = 0 -%}
{%- assign variant_count = 0 -%}
{%- assign subscribe_count = 0 -%}
{%- assign collapsed_count = 0 -%}
{%- assign trynow_count = 0 -%}
{%- assign timer = blank -%}
{%- assign free_gift = blank -%}
{%- assign list_count_reduced = 0 -%}

{%- for block in section.blocks -%}
	{%- case block.type -%}
        {%- when 'rating' -%}
            {%- assign rating_count = rating_count | plus: 1 -%}    
        {%- when 'list' -%}
            {%- assign list_count = list_count | plus: 1 -%}
        {%- when 'list_reduced' -%}
            {%- assign list_count_reduced = list_count_reduced | plus: 1 -%}
        {%- when 'supply' -%}
            {%- assign supply_count = supply_count | plus: 1 -%}
        {%- when 'variant' -%}
            {%- assign variant_count = variant_count | plus: 1 -%}
        {%- when 'subscribe' -%}
            {%- assign subscribe_count = subscribe_count | plus: 1 -%}
        {%- when 'collapsed' -%}
            {%- assign collapsed_count = collapsed_count | plus: 1 -%}
        {%- when 'trynow' -%}
            {%- assign trynow_count = trynow_count | plus: 1 -%}
        {%- when 'timer' -%}
            {%- assign timer = block -%}
        {%- when 'free_gift' -%}
            {%- assign free_gift = block -%}
    {%- endcase -%}
{%- endfor -%}

{%liquid
    assign new_design = false
    if section.settings.selected_design == 'new'
        assign new_design = true
    elsif section.settings.selected_design == 'old'
        assign new_design = false
    endif
%}

{% if section.settings.product != blank %}
    {% assign product = section.settings.product %}
{% endif %}


<!-- -- main banner start -- -->
<div class="refill_bl pt-0 tabSlider">
    <div class="container">
        <div class="row">
            <div class="col-md-6 order-2 order-md-1">
                <div class="refill_info pt-0 pt-md-3">

                    {% if rating_count %}
                        {%- for block in section.blocks -%}
                            {% if block.type == 'rating' %}
                                {% if product.metafields.reviews.rating_count.value > 5 %}
                                    {% render 'product-rating', rating_value: product.metafields.reviews.rating.value, rating_count: product.metafields.reviews.rating_count.value %}
                                {% else %}
                                    <div class="refill_review">
                                        <div class="star_gp">
                                            {% if block.settings.image != blank %}
                                                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}">
                                            {% endif %}
                                        </div>
                                        {{ block.settings.text |  replace: '<p>', '<p class="text-sm fw-normal" style="text-decoration: none;">' }}
                                        </p>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {%- endfor -%}
                    {% endif %}

                    {% if section.settings.seo_heading != blank %}
                        <h1 class="seo_heading">{{ section.settings.seo_heading }}</h1>
                    {% endif %}
                    
                    <div class="section_header text-start">
                        {% if section.settings.heading != blank %}
                            <h2 class="title-xl d-none d-md-block">{{ section.settings.heading | replace: '\n', '<br />' }}</h2>
                        {% endif %}
                        {% if section.settings.heading_mobile != blank %}
                            <h2 class="title-xl d-md-none">{{ section.settings.heading_mobile | replace: '\n', '<br />' }}</h2>
                        {% elsif section.settings.heading != blank %}
                            <h2 class="title-xl d-md-none">{{ section.settings.heading | replace: '\n', '<br />' }}</h2>
                        {% endif %}
                    </div>

                    {% if settings.show_bf_price == true %}
                        {% render 'bf-price-displaying', product: product %}
                    {% else %}
                        {% unless page.handle == 'qure-micro-infusion-landing-page-affiliate' %}
                            <div class="price_wrap">
                                <div class="price">
                                    <div class="new_price">
                                        {% render 'pdm_product-price' subscribe_count: subscribe_count, section: section %}
                                    </div>
                                </div>
                            </div>
                        {% endunless %}
                    {% endif %}

                    <div class="mw-452">
                        {% if list_count > 0 %}
                            <div class="ss_list py-4 original-copy">
                                <ul>
                                {%- for block in section.blocks -%}
                                    {% if block.type == 'list' %}
                                        {% if block.settings.text %}
                                            {{ block.settings.text }}
                                        {% endif %}
                                    {% endif %}
                                {%- endfor -%} 
                                </ul>
                            </div>
                        {% endif %}

                        {% if list_count_reduced > 0 %}
                            <div class="ss_list py-4 reduced-copy">
                                <ul>
                                {%- for block in section.blocks -%}
                                    {% if block.type == 'list_reduced' %}
                                        {% if block.settings.text %}
                                            {{ block.settings.text }}
                                        {% endif %}
                                    {% endif %}
                                {%- endfor -%} 
                                </ul>
                            </div>
                        {% endif %}

                        <div class="green_line">
                            <hr>    
                        </div>

                        {% if variant_count > 0 %}
                            {% render 'product-extended-variants' %}
                        {% endif %}

                        {% if supply_count > 0 %}
                            <div class="next_batch_bl next_batch_highlight">
                                {%- for block in section.blocks -%}
                                    {% if block.type == 'supply' %}
                                        {% if block.settings.heading != blank %}
                                            <h6 class="d-none d-md-block">{{ block.settings.heading }}</h6>
                                        {% endif %}

                                        {% if block.settings.heading_mobile != blank %}
                                            <h6 class="d-md-none">{{ block.settings.heading_mobile }}</h6>
                                        {% endif %}
                                        
                                        {% if block.settings.text != blank %}
                                            {{ block.settings.text }}
                                        {% endif %}

                                        {% if block.settings.first_option_text != blank %}
                                            <div class="batch_h batch_h_fade mt-3 mt-md-4">
                                                <div class="batch_h_month">{{ block.settings.first_option_date }}</div>
                                                <div class="batch_h_info sold_out_h" style="--bgPercent:{{ block.settings.first_option_percent }}%;"><span>{{ block.settings.first_option_text }}</span></div>
                                            </div>
                                        {% endif %}

                                        {% if block.settings.second_option_text != blank %}
                                            <div class="batch_h my-2">
                                                <div class="batch_h_month">{{ block.settings.second_option_date }}</div>
                                                <div class="batch_h_info" style="--bgPercent:{{ block.settings.second_option_percent }}%;">{{ block.settings.second_option_text }}</div>
                                            </div>
                                        {% endif %}

                                        {% if block.settings.third_option_text != blank %}
                                            <div class="batch_h batch_h_fade">
                                                <div class="batch_h_month">{{ block.settings.third_option_date }}</div>
                                                <div class="batch_h_info" style="--bgPercent:{{ block.settings.third_option_percent }}%;"><span>{{ block.settings.third_option_text }}</span></div>
                                            </div>
                                        {% endif %}

                                    {% endif %}
                                {%- endfor -%}
                            </div>
                        {% endif %}

                        {% if subscribe_count > 0 or trynow_count > 0 %}
                            {%- for block in section.blocks -%}
                                {% if block.type == 'trynow' %}
                                    {% include 'product-extended-new-trynow' variant_count: variant_count %}
                                {% endif %}

                                {% if block.type == 'subscribe' %}
                                    {% include 'product-extended-new-subscription' variant_count: variant_count %}
                                {% endif %}
                            {%- endfor -%}
                        {% else %}
                            {% if section.settings.soldout == true %}
                                <a class="btn btn-lg btn-primary buy_btn" href="#">Sold Out</a>
                            {% else %}
                                {% if product.variants.first.available %}
                                    <a class="btn btn-lg btn-primary buy_btn" href="{{ routes.cart_add_url }}?id={{ product.variants.first.id }}&quantity=1" onclick="setEventProductHandler('{{ product.handle | escape }}')" data-ajax-cart-request-button>{% if section.settings.reserve == true %}Reserve now{% else %}Buy Now{% endif %}</a>
                                {% else %}
                                    <a class="btn btn-lg btn-primary buy_btn" href="#">{% if section.settings.reserve == true %}Reserve now{% else %}Sold Out{% endif %}</a>
                                {% endif %} 
                            {% endif %}

                            {% if product.compare_at_price != blank %}
                                {% render 'product-sticky-button' with
                                    variant_id: product.variants.first.id, 
                                    current_price: product.price, 
                                    original_price: product.compare_at_price, 
                                    product_data: product,
                                %}                    
                            {% else %}
                                {% render 'product-sticky-button' with
                                    variant_id: product.variants.first.id, 
                                    current_price: product.price, 
                                    original_price: product.price, 
                                    product_data: product, 
                                %}
                            {% endif %}

                            {% if timer != blank %}
                                {% render 'product-timer' with block: timer %}
                            {% endif %}

                            {% if free_gift != blank %}
                                {% render 'product-free-gift' with block: free_gift %}
                            {% endif %}
                        {% endif %}

                        {% assign array_products_to_exclude = "" %}
                        {% assign products_to_exclude = "" %}
                        {% for excluded_product in settings.frontrow_product_list_to_exclude %}
                            {% assign products_to_exclude = products_to_exclude | append: excluded_product.handle %}
                            {% unless forloop.last  %}
                                {% assign products_to_exclude = products_to_exclude | append: "," %}
                            {% endunless %}
                        {% endfor %}
                        {% assign array_products_to_exclude = products_to_exclude | split: "," %}
                        {% unless array_products_to_exclude contains product.handle  %}
                            {% render 'pdm_pdp-frontrow-health' %}
                        {% endunless %}

                        <div class="shipping shipping_bg bg-transparent d-flex pt-3">
                            <div class="s_bx gap-2">
                                <img src="{{ 'dermatologist.svg' | asset_url }}" alt="">
                                <p class="d-none d-md-block p-0">Dermatologist<br>Reviewed</p>
                                <p class="d-md-none p-0">Dermatologist <br>Reviewed</p>
                            </div>
                            <div class="s_bx gap-2">
                                <img src="{{ '90_days.svg' | asset_url }}" alt="">
                                <p class="d-none d-md-block p-0">90-day supply</p>
                                <p class="d-md-none p-0">90-day supply</p>
                            </div>
                            <div class="s_bx gap-2">
                                <img src="{{ 'free_shipping_new.svg' | asset_url }}" alt="">
                                <p class="d-none d-md-block p-0">Free Shipping <br>Over $100</p>
                                <p class="d-md-none p-0">Free Shipping <br>Over $100</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% render 'pdm_cross-sell', cross-sell-products: product.metafields.custom.cross_sell.value, visibility: "mobile" %}

            {% if collapsed_count > 0 %}
                {% render 'product-extended-new-collapsed', visibility: "mobile" %}
            {% endif %}

            <div class="col-md-6  order-1 order-md-2">
                {% if new_design == false %}
                <div class="refill_slider mw-mob-100 pt-md-5 slider-old-design">
                    <div {% if section.settings.before_after_images_limit > 0 %}class="refill_s_tab_content"{% endif %}>
                        <div class="tab-content" id="pills-tabContent">
                            <div class="tab-pane fade show active" id="pills-home" role="tabpanel"
                                aria-labelledby="pills-home-tab">
                                <div 
                                    class="swiper twa__swiper productSlider dot_pagination"
                                    id="twa__swiper-productSlider" 
                                    data-section-id="productSlider"
                                    data-autoplay="false" 
                                    data-loop="false" 
                                    data-centerslide="false"
                                    data-mobile="1.1" 
                                    data-tablet="1" 
                                    data-desktop="1" 
                                    data-spacing="10"
                                    data-arrowleft="productSlider-swiper-prev"
                                    data-arrowright="productSlider-swiper-next">
                                    <div class="swiper-wrapper">
                                        {% for media in product.media limit:section.settings.product_images_limit offset:1 %}
                                            {% if forloop.index == 1 and section.settings.wistia_id != blank %}
                                                <div class="swiper-slide video_popup pe-none">
                                                    <div class="wistia_responsive_padding" style="position:relative;">
                                                        <div class="wistia_responsive_wrapper"
                                                            style="height:100%;left:0;position:absolute;top:0;width:100%;">
                                                            <div class="wistia_embed wistia_async_{{ section.settings.wistia_id }} seo=false videoFoam=true"
                                                                style="height:100%;position:relative;width:100%">
                                                                <div class="wistia_swatch"
                                                                    style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;">
                                                                    <img src="https://fast.wistia.com/embed/medias/{{ section.settings.wistia_id }}/swatch"
                                                                        style="filter:blur(5px);height:100%;object-fit:contain;width:100%;"
                                                                        alt="" aria-hidden="true"
                                                                        onload="this.parentNode.style.opacity=1;" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% else %}
                                                {% if media.media_type == 'video' %}

                                                    {% if media.sources[1].url != blank %}
                                                        {% assign video_source_url = media.sources[1].url %}
                                                    {% else %}
                                                        {% assign video_source_url = media.sources[0].url %}
                                                    {% endif %}

                                                    <div class="swiper-slide video_popup">
                                                        <a class="popup-youtube d-block"
                                                            href="{{ video_source_url }}">
                                                            <picture id="image-id">
                                                                <source media="(min-width:1920px)" srcset="{{ media | img_url: 'master' }}">
                                                                <source media="(min-width:1600px)" srcset="{{ media | img_url: '1600x' }}">
                                                                <source media="(min-width:1100px)" srcset="{{ media | img_url: '1100x' }}">
                                                                <source media="(min-width:720px)" srcset="{{ media | img_url: '720x' }}">
                                                                <source media="(min-width:540px)" srcset="{{ media | img_url: '540x' }}">
                                                                <img class="img-fluid" src="{{ media | img_url: '540x' }}" width="100" height="100" alt="{{ block.settings.image.alt | escape }}">
                                                            </picture>
                                                        </a>
                                                    </div>   
                                                {% else %}
                                                    <div class="swiper-slide">
                                                        <a class="banner-popup-link" id="popup-link">
                                                            <picture id="image-id">
                                                                <source media="(min-width:1920px)" srcset="{{ media | img_url: 'master' }}">
                                                                <source media="(min-width:1600px)" srcset="{{ media | img_url: '1600x' }}">
                                                                <source media="(min-width:1100px)" srcset="{{ media | img_url: '1100x' }}">
                                                                <source media="(min-width:720px)" srcset="{{ media | img_url: '720x' }}">
                                                                <source media="(min-width:540px)" srcset="{{ media | img_url: '540x' }}">
                                                                <img class="img-fluid tab_img" src="{{ media | img_url: '540x' }}" width="100" height="100" alt="{{ block.settings.image.alt | escape }}">
                                                            </picture>
                                                        </a>
                                                    </div> 
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    {% if section.settings.before_after_images_limit > 0 %}
                                        <div class="swiper-pagination"></div>
                                    {% else %}
                                        <div class="pagination_navigation mt-3 mt-md-5">
                                            <div class="swiper-pagination"></div>
                                            <div class="swiper-button-prev productSlider-swiper-prev swiper-button"></div>
                                            <div class="swiper-button-next productSlider-swiper-next swiper-button"></div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% if section.settings.before_after_images_limit > 0 %}
                                <div 
                                    data-test="product-water"
                                    class="tab-pane fade" 
                                    id="pills-profile" 
                                    role="tabpanel"
                                    aria-labelledby="pills-profile-tab">
                                    <div class="swiper twa__swiper realResultSlider dot_pagination"
                                        id="twa__swiper-realResultSlider" data-section-id="realResultSlider"
                                        data-autoplay="false" data-loop="false" data-centerslide="false"
                                        data-mobile="1.1" data-tablet="1" data-desktop="1" data-spacing="10"
                                        data-arrowleft="realResultSlider-swiper-prev"
                                        data-arrowright="realResultSlider-swiper-next">
                                        <div class="swiper-wrapper">
                                            {% assign after_images_offset = section.settings.product_images_limit | plus: 1 %}
                                            {% for media in product.media limit:section.settings.before_after_images_limit offset: after_images_offset %}
                                                <div class="swiper-slide">
                                                    <a class="banner-popup-link" id="popup-link">
                                                        <picture id="image-id">
                                                            <source media="(min-width:1920px)" srcset="{{ media | img_url: 'master' }}">
                                                            <source media="(min-width:1600px)" srcset="{{ media | img_url: '1600x' }}">
                                                            <source media="(min-width:1100px)" srcset="{{ media | img_url: '1100x' }}">
                                                            <source media="(min-width:720px)" srcset="{{ media | img_url: '720x' }}">
                                                            <source media="(min-width:540px)" srcset="{{ media | img_url: '540x' }}">
                                                            <img class="img-fluid tab_img" src="{{ media | img_url: '540x' }}" width="100" height="100" alt="{{ block.settings.image.alt | escape }}">
                                                        </picture>
                                                    </a>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <div class="swiper-pagination"></div>
                                    </div>
                                </div> 
                            {% endif %}
                        </div>
                    </div>
                    {% if section.settings.before_after_images_limit > 0 %}
                        <div class="refill_s_tab">
                            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="pills-home-tab" data-bs-toggle="pill"
                                        data-bs-target="#pills-home" type="button" role="tab"
                                        aria-controls="pills-home" aria-selected="true">{{ section.settings.product_button_label }}</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link d-md-block" id="pills-profile-tab"
                                        data-bs-toggle="pill" data-bs-target="#pills-profile" type="button"
                                        role="tab" aria-controls="pills-profile" aria-selected="false">{{ section.settings.before_after_button_label }}</button>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                </div>
                {% endif %}
                {% comment %} end component original {% endcomment %}
                {% if new_design == true %}
                     {% comment %} pdp caroulsel redesign {% endcomment %}
                    {% render 'pdm_before_after_carousel', settings: section.settings, section_name: 'product-extended' %}
                {% endif %}
                
                {% render 'pdm_cross-sell', cross-sell-products: product.metafields.custom.cross_sell.value, visibility: "desktop" %}

                {% if collapsed_count > 0 %}
                    {% render 'product-extended-new-collapsed', visibility: "desktop" %}
                {% endif %}
            </div>
        </div>
    </div>
</div>
<!-- -- main banner end -- -->

{% assign current_variant = product.selected_or_first_available_variant %}
<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  {% if product.featured_image %}
    {% assign image_size = product.featured_image.width | append: 'x' %}
    "image": [
      "https:{{ product.featured_image.src | img_url: image_size }}"
    ],
  {% endif %}
  "description": "{{ product.description | strip_html | escape }}",
  {% if current_variant.sku != blank %}
    "sku": "{{ current_variant.sku }}",
  {% endif %}
  "brand": {
    "@type": "Thing",
    "name": "{{ product.vendor | escape }}"
  },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type" : "Offer",
        {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
        {%- endif -%}
        {%- if variant.barcode.size == 12 -%}
          "gtin12": {{ variant.barcode }},
        {%- endif -%}
        {%- if variant.barcode.size == 13 -%}
          "gtin13": {{ variant.barcode }},
        {%- endif -%}
        {%- if variant.barcode.size == 14 -%}
          "gtin14": {{ variant.barcode }},
        {%- endif -%}
        "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price" : {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency" : {{ cart.currency.iso_code | json }},
        "url" : {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{% schema %}
    {
        "name": "t:sections.product-extended-new.name",
        "class": "section-product-extended-new",
        "settings": [
            {
                "type": "text",
                "id": "seo_heading",
                "label": "t:common.heading.seo_heading.label"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "t:common.heading.label"
            },
            {
                "type": "text",
                "id": "heading_mobile",
                "label": "t:common.heading.mobile.label"
            },
            {
                "type": "text",
                "id": "one_time_purchase",
                "label": "t:common.one-time_purchase.label"
            },
            {
                "type": "product",
                "id": "product",
                "label": "t:common.product.label"
            },
            {
                "type": "text",
                "id": "wistia_id",
                "label": "t:common.wistia.id.label"
            },
            {
                "type": "range",
                "id": "product_images_limit",
                "min": 1,
                "max": 8,
                "step": 1,
                "unit": "t:sections.product-extended-new.settings.product_images_limit.unit",
                "label": "t:sections.product-extended-new.settings.product_images_limit.label",
                "default": 5
            },
            {
                "type": "text",
                "id": "product_button_label",
                "default": "Product",
                "label": "t:common.button.label",
                "info": "t:common.button.info"
            },
            {
                "type": "range",
                "id": "before_after_images_limit",
                "min": 0,
                "max": 5,
                "step": 1,
                "unit": "t:sections.product-extended-new.settings.before_after_images_limit.unit",
                "label": "t:sections.product-extended-new.settings.before_after_images_limit.label",
                "default": 2
            },
            {
                "type": "text",
                "id": "before_after_button_label",
                "default": "Before & After",
                "label": "t:common.button.label",
                "info": "t:common.button.info"
            },
            {
                "type": "checkbox",
                "id": "reserve",
                "label": "t:common.reserve.label",
                "default": false
            },
            {
                "type": "checkbox",
                "id": "soldout",
                "label": "t:common.soldout.label",
                "default": false
            },
            {
                "type": "text",
                "id": "underbutton_text_left",
                "label": "t:common.text.label",
                "default": "Dermatologist Reviewed"
            },
            {
                "type": "text",
                "id": "underbutton_text_right",
                "label": "t:common.text.label",
                "default": "Free Shipping Over $100"
            },
            {
                "type": "header",
                "content": "Select Design",
                "info": "Select the design for the images section, default is old design"
            },
            {
                "type": "select",
                "id": "selected_design",
                "label": "Design",
                "default": "old",
                "options": [
                    {
                        "value": "old",
                        "label": "Old"
                    },
                    {
                        "value": "new",
                        "label": "New"
                    }
                ]
            },
            {
