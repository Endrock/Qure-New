    "name": "Result Product Slider",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Main Heading",
        "default": "Thousands are out-glowing their insecurities"
      },
      {
        "type": "image_picker",
        "id": "star_image",
        "label": "Star Image"
