<!-- -- result section start -- -->
<div class="result_s section mi_landing_result" id="result_section">
    <div class="container">
      <div class="section_header text-center mb-3 mw-100">
        <h2 class="title-lg paddingB">
          {{ section.settings.heading }}
        </h2>
        <div class="refill_review justify-content-center">
          <div class="star_gp">
            {% if section.settings.star_image %}
              <img src="{{ section.settings.star_image | img_url: 'medium' }}" alt="">
            {% endif %}
          </div>
          <p class="text-sm fw-normal text-decoration-none">{{ section.settings.review_text }}</p>
        </div>
      </div>
  
      <div class="result_s_wrapper">
        <div class="swiper dot_pagination result_slider">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide">
                <div class="result_item result_item_info_with_fixed">
                  <div class="result_img_m">
                    {% if block.settings.image %}
                      <img src="{{ block.settings.image | img_url: 'medium' }}" alt="" class="img-fluid">
                    {% endif %}
                  </div>
                  <div class="result_c_info pb-0">
                    <div class="star_gp">
                      <p>{{ block.settings.title }}</p>
                    </div>
                  </div>
                  <div class="result_item_info">
                    <div class="result_content">
                      <p>{{ block.settings.review }}</p>
                    </div>
                  </div>
                  <div class="result_learnMore d-block">
                    <div class="result_learnMore_wrap">
                      <div class="result_c_info">
                        <div class="r_flag">
                          <div class="flag_img">
                            {% if block.settings.country_flag %}
                              <img src="{{ block.settings.country_flag | img_url: 'small' }}" alt="" class="img-fluid">
                            {% endif %}
                          </div>
                          <p class="r_c_name pe-2">{{ block.settings.customer_name }}</p>
                        </div>
                        <div class="verified_img">
                          {% if block.settings.verified_image %}
                            <img src="{{ block.settings.verified_image | img_url: 'small' }}" alt="">
                          {% endif %}
                          <p>{{ block.settings.verified_text }}</p>
                        </div>
                      </div>
                    </div>
                    <div class="d-grid prod_uses">
                      <div class="prod_img">
                        {% if block.settings.product_image %}
                          <img src="{{ block.settings.product_image | img_url: 'small' }}" alt="" class="img-fluid">
                        {% endif %}
                      </div>
                      <div class="prod_rev">
                        <p>{{ block.settings.customer_name_with_prod }}</p> 
                      </div>
                      <div class="learn_more_prod">
                        <a href="{{ block.settings.button_link }}">{{ block.settings.btn_text }}</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %} 
          </div>
            <div class="pagination_navigation">
                <div class="swiper-pagination"></div>
                <div class="qureSlider-swiper-prev swiper-button-prev swiper-button"></div>
                <div class="qureSlider-swiper-next  swiper-button-next swiper-button"></div>
            </div>
        </div>
      </div>
    </div>
  </div>
  
  
  {% schema %}
