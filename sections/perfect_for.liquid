<div class="ingredients_list {{ section.settings.custom_class }} ingredients_list-{{ section.id }}">
    <div class="container">
        <div class="section_header text-start pb-md-5 pb-4 text-md-center ms-0 m-md-auto">
            {% if section.settings.sub_heading != blank %}
                <h6 class="n_sub-heading">{{ section.settings.sub_heading }}</h6>
            {% endif %}
            {% if section.settings.discrition != blank %}
              {{ section.settings.discrition }}
            {% endif %}
        </div>
        <div class="skin_problems">
            {% for block in section.blocks %}
                {% if block.type == 'problem' %}
                    <div class="problem_inner">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | img_url: 'master' }}" class="img-fluid" alt="">
                        {% endif %}
                        <div class="pt-md-4 pt-2">
                            {% if block.settings.description != blank %}
                                <p>
                                    {% if block.settings.icon != blank %}
                                        <img src="{{ block.settings.icon | img_url: 'small' }}" alt="">
                                    {% endif %}
                                    {{ block.settings.description }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>
{% style %}
.ingredients_list-{{ section.id }} .skin_problems {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desk_column }}, 1fr);
    gap: 38px;
    text-align: center;
}
@media(max-width: 768px){
  .ingredients_list-{{ section.id }} .skin_problems {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
}
{% endstyle %}
