<div class="product_bundle offer-lp section qure_filter_shower_new mt-3 mt-md-5">
  <div class="container">
    <div class="product_bundle-content">
      <div class="row gy-3">
        <div class="col-md-6">
          <div class="bfs_mb_slider refill_slider mw-mob-100 refill_slider_new">
            <div
              class="swiper bfs_mb_sl2 twa__swiper realResultSlider dot_pagination"
              id="twa__swiper-realResultSlider"
              data-section-id="realResultSlider"
              data-autoplay="false"
              data-loop="false"
              data-centerslide="false"
              data-mobile="1"
              data-tablet="1"
              data-desktop="1"
              data-spacing="10"
              data-arrowleft="realResultSlider-swiper-prev"
              data-arrowright="realResultSlider-swiper-next"
            >
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  {% if block.type == 'slide' %}
                    <div class="swiper-slide">
                      {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | img_url: 'master' }}" class="img-fluid" alt="">
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="thumbsSlider_wrap mt-3">
              <div thumbsSlider="" class="swiper bfs_mb_sl pagination_navigation1">
                <div class="swiper-wrapper">
                  {% for block in section.blocks %}
                    {% if block.type == 'slide' %}
                      <div class="swiper-slide">
                        <div class="bfs_mb_wrapThumb">
                          {% if block.settings.thumbnail != blank %}
                            <img src="{{ block.settings.thumbnail | img_url: 'master' }}" class="img-fluid" alt="">
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              <div class="thumb-next swiper-button-next swiper-button"></div>
              <div class="thumb-prev swiper-button-prev swiper-button"></div>
            </div>
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'popup' %}
              {% if block.settings.video_btn !=blank %}
          <a class="see_action d-flex justify-content-center popup-youtube pt-3 pb-2 text-black" href="{{ block.settings.video_url }}">
            <p>
                <img src="{{ 'play_circle-green.svg' | asset_url }}" alt="" class="img-fluid">
                    {{ block.settings.video_btn }}
            </p>
        </a>
      {% endif %}
      {% endif %}
    {% endfor %}
        </div>
        <div class="col-md-6">
          <div class="bundle_select-main include ps-md-3">
            <div class="product_details">
              <div class="holiday_spcl mb-md-2 mb-3 justify-content-start">
                {% if section.settings.study_highlight != blank %}
                  <p class="save_txt">
                    <span class="in_study">{{ section.settings.in_study_text }}</span>
                    <span
                      class="text-decoration-underline fw-normal"
                    >
                      {{- section.settings.study_highlight -}}
                    </span>
                  </p>
                {% endif %}
              </div>
              {% if section.settings.heading != blank %}
                <h2 class="title-lg mb-3">{{ section.settings.heading }}</h2>
              {% endif %}
              {% if section.settings.description != blank %}
                <p>{{ section.settings.description }}</p>
              {% endif %}
            </div>
            <div class="adjust_angle my-4 my-md-5">
              <div class="row">
                <div class="col-lg-10">
                  <div class="row g-3">
                    {% for block in section.blocks %}
                      {% if block.type == 'feature' %}
                        <div class="col-sm-6">
                          <div class="adjust_icons">
                            {% if block.settings.feature_image != blank %}
                              <img src="{{ block.settings.feature_image | img_url: 'master' }}" alt="">
                            {% endif %}
                            {% if block.settings.feature_text != blank %}
                              <span>{{ block.settings.feature_text }}</span>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
            <a href="{{ section.settings.button_link }}" class="qure_shower_filter_btn text-decoration-underline">
              {{- section.settings.button_text -}}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product_detail.label",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:common.heading.label"
    },
    {
      "type": "text",
      "id": "in_study_text",
      "label": "t:common.highlighted.study"
    },
    {
      "type": "text",
      "id": "study_highlight",
      "label": "t:common.highlighted.text"
    },
