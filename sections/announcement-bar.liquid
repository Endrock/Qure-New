<!-- Announcement Bar -->
{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<div id="announcement-bar" class="announcement-bar" style="--ans-bar-font-size:16px; --anc-bar-font-weight :400;">
  {% render 'icon-arrow-right', class: 'arrow arrow-icon-left', id: 'prevButton' %}
  <div class="announcement-container">
    <div class="announcement-carousel">
      {% for block in section.blocks %}
        <div
          class="announcement-bar-content text-center {% if forloop.first %}active{% endif %} {% if block.settings['button-label'] != blank %}has-button{%  endif %}"
          data-index="{{ forloop.index0 }}"
        >
          {% if block.settings.icon != blank -%}
            <img
              loading="lazy"
              width="18"
              height="18"
              class="icon"
              src="{{ block.settings.icon | image_url }}"
              alt="{{ block.settings.icon.alt | escape }}"
            >
          {%- endif %}
          {{ block.settings.heading }}
          {% if block.settings['button-label'] != blank -%}
            <a class="button" href="{{ block.settings.button-url }}">{{ block.settings['button-label'] }}</a>
          {%- endif %}
        </div>
      {%- endfor %}
    </div>
  </div>
  {% render 'icon-arrow-right', class: 'arrow arrow-icon-right', id: 'nextButton' %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const announcementBar = document.getElementById('announcement-bar');
    const announcements = announcementBar.querySelectorAll('.announcement-bar-content');
    const prevButton = announcementBar.querySelector('.arrow-icon-left');
    const nextButton = announcementBar.querySelector('.arrow-icon-right');
    const delaySeconds = {{ section.settings.delay | default: 5 }};

    let currentIndex = 0;
    let rotationInterval;

    if (announcements[currentIndex].classList.contains('has-button')) {
        announcementBar.classList.add('large');
      } else {
        announcementBar.classList.remove('large');
      }

    if (announcements.length <= 1) {
      if (prevButton) prevButton.style.display = 'none';
      if (nextButton) nextButton.style.display = 'none';
      return;
    }

    function showAnnouncement(index) {
      announcements.forEach(announcement => {
        announcement.classList.remove('active');
      });

      announcements[index].classList.add('active');
      currentIndex = index;
      if (announcements[index].classList.contains('has-button')) {
        announcementBar.classList.add('large');
      } else {
        announcementBar.classList.remove('large');
      }
    }

    function nextAnnouncement() {
      const nextIndex = (currentIndex + 1) % announcements.length;
      showAnnouncement(nextIndex);
    }

    function prevAnnouncement() {
      const prevIndex = (currentIndex - 1 + announcements.length) % announcements.length;
      showAnnouncement(prevIndex);
    }

    function startRotation() {
      if (delaySeconds > 0) {
        rotationInterval = setInterval(nextAnnouncement, delaySeconds * 1000);
      }
    }

    function stopRotation() {
      if (rotationInterval) {
        clearInterval(rotationInterval);
      }
    }

    function restartRotation() {
      stopRotation();
      startRotation();
    }

    if (nextButton) {
      nextButton.addEventListener('click', function() {
        nextAnnouncement();
        restartRotation();
      });
    }

    if (prevButton) {
      prevButton.addEventListener('click', function() {
        prevAnnouncement();
        restartRotation();
      });
    }

    announcementBar.addEventListener('mouseenter', stopRotation);
    announcementBar.addEventListener('mouseleave', startRotation);

    startRotation();
  });
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "number",
      "id": "delay",
      "label": "Delay in seconds",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:common.header"
        },
        {
          "type": "text",
          "id": "button-label",
          "label": "t:common.button-label"
        },
        {
          "type": "text",
          "id": "button-url",
          "label": "t:common.button-url"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name"
    }
  ]
}
{% endschema %}
