{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
{{ 'splide.min.css' | asset_url | stylesheet_tag }}

<div id="announcement-bar" class="announcement-bar" style="--ans-bar-font-size:16px; --anc-bar-font-weight :400;">
  <div class="announcement-container">
    <div class="splide" aria-label="Splide carousel">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li
              class=" splide__slide announcement-bar-content text-center {% if forloop.first %}active{% endif %} {% if block.settings['button-label'] != blank %}has-button{%  endif %}"
              data-index="{{ forloop.index0 }}"
            >
              {% if block.settings.icon != blank -%}
                <img
                  loading="lazy"
                  width="18"
                  height="18"
                  class="icon"
                  src="{{ block.settings.icon | image_url }}"

                  alt="{{ block.settings.icon.alt | escape }}"
                >
              {%- endif %}
              <span>{{ block.settings.heading }}</span>
              {% if block.settings['button-label'] != blank -%}
                <a class="button" href="{{ block.settings.button-url }}">{{ block.settings['button-label'] }}</a>
              {%- endif %}
            </li>
          {%- endfor %}
        </ul>
      </div>
      <div class="splide__arrows splide__arrows--ltr">
        <button
          class="splide__arrow splide__arrow--prev"
          type="button"
          aria-label="Previous slide"
          aria-controls="splide01-track"
        >
          {% render 'icon-arrow-right', class: 'arrow arrow-icon-left', id: 'prevButton' %}
        </button>
        <button
          class="splide__arrow splide__arrow--next"
          type="button"
          aria-label="Next slide"
          aria-controls="splide01-track"
        >
          {% render 'icon-arrow-right', class: 'arrow arrow-icon-right', id: 'nextButton' %}
        </button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'splide.min.js' | asset_url  }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const annoucement = document.querySelector('.announcement-bar .splide');
    console.log("🚀 ~ annoucement:", annoucement)
    const splide = new Splide(annoucement, {
      type: 'fade',
      rewind: true,
      focus: 'center',
      perPage: 1,
      perMove: 1,
      pauseOnHover: false,
      pagination: false,
      autoplay: true,
      interval:  {{ section.settings.delay }},
    });

    splide.mount();
    console.log('🚀 ~ splide:', splide);
  });
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "number",
      "id": "delay",
      "label": "Delay in milliseconds",
      "default": 3000
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",

          "id": "heading",
          "label": "t:common.header"
        },
        {
          "type": "text",
          "id": "button-label",
          "label": "t:common.button-label"
        },
        {
          "type": "text",

          "id": "button-url",
          "label": "t:common.button-url"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name"
    }
  ]
}
{% endschema %}
