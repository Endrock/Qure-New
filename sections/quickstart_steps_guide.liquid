{% schema %}
{
  "name": "LED Guide Intro",
  "settings": [
    {
      "type": "text",
      "id": "guide_heading",
      "label": "Guide Contents Heading",
      "default": "Guide Contents"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Get Started Button Text",
      "default": "Let's Get Started!"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button Icon"
    }
  ],
  "blocks": [
    {
      "type": "guide_link",
      "name": "Guide Link",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step Label",
          "default": "What’s In The Box"
        },
        {
          "type": "text",
          "id": "step_id",
          "label": "Step ID (e.g. step1)",
          "default": "step1"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "LED Guide Intro",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<main class="homepage q-urify_safety led_guide">
  <div id="zero_step" class="content"></div>
  <div class="bg-white">
    <div class="container">
      <div class="instruction_inner border-bottom-0 pb-0"></div>
      <div class="instruction_manual">
        <h5>{{ section.settings.guide_heading }}</h5>
      </div>
      <div class="row justify-content-end mw-mob-100">
        <div class="col-md-9 pb-md-4 pb-3">
          <div class="search_main position-relative">
            <input type="search" class="static_search" placeholder="Search">
            <button type="submit">
              <img src="https://qureskincaredns.com/new/assets/search2.svg" alt="">
            </button>
          </div>
        </div>
        <div class="col-md-9">
          <div class="contents-info">
            <div class="tab">
              <div class="row">
                {% assign column_size = 2 %}
                {% assign items_per_column = section.blocks.size | divided_by: column_size | ceil %}
                {% for column in (1..column_size) %}
                  <div class="col-md-4">
                    <ul>
                      {% for block in section.blocks offset: items_per_column | times: column | minus: items_per_column limit: items_per_column %}
                        {% if block.type == 'guide_link' %}
                          <li>
                            <span>{{ block.settings.step_number }}</span>
                            <a href="#{{ block.settings.step_id }}" data-section="{{ block.settings.step_id }}" class="menu-item tablinks">
                              {{ block.settings.step_label }}
                            </a>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="pt-md-5">
      <div class="let_start-btn">
        <div class="container">
          <div class="text-end">
            <button class="let_start btn see_more" onclick="showTabNavigation()">
              <span class="me-2">{{ section.settings.button_label }}</span>
              {% if section.settings.button_icon %}
                <img src="{{ section.settings.button_icon | image_url }}" alt="">
              {% endif %}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
