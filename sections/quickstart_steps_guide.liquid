<div class="led_guide_quickstart">
  <div class="banner">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 order-md-2">
          <img 
            src="{{ section.settings.banner_image_desktop | image_url }}" 
            class="img-fluid d-none d-md-block" 
            alt="Banner">
          <img 
            src="{{ section.settings.banner_image_mobile | image_url }}" 
            class="img-fluid d-md-none pt-5 mt-3" 
            alt="Banner Mobile">
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
          <div class="ps-md-5">
            <h1 class="d-none d-md-block">{{ section.settings.heading }}</h1>
            <h1 class="d-md-none">{{ section.settings.heading }}</h1>
            <h6>{{ section.settings.subheading }}</h6>
            <p>{{ section.settings.intro_text }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="whats_in_the_box pt-5 pb-3">
    <div class="container">
      <h3 class="mb-4">What’s in the Box</h3>
      <div class="row">
        {% for block in section.blocks %}
          {% if block.type == 'box_item' %}
            <div class="col-md-6">
              <div class="item_wrapper">
                <div class="img_wrapper">
                  {% if block.settings.item_icon %}
                    <img src="{{ block.settings.item_icon | image_url }}" alt="{{ block.settings.item_label }}">
                  {% endif %}
                  <div class="item-text">
                    <p>{{ block.settings.item_label }}</p>
                  </div>
                </div>
                <div class="qty">{{ block.settings.item_qty }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="guide_steps pt-5">
    <div class="container">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="guide_step mb-5">
            <h5>{{ block.settings.step_title }}</h5>
            <div class="row">
              <div class="col-md-6">
                <div class="step_text">{{ block.settings.step_description }}</div>
              </div>
              <div class="col-md-6">
                {% if block.settings.step_image %}
                  <img src="{{ block.settings.step_image | image_url }}" class="img-fluid" alt="Step Image">
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>



{% schema %}
{
  "name": "Quickstart Steps Guide",
  "tag": "section",
  "class": "section-nd-led-guide",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image_desktop",
      "label": "Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Get started with your Neck & Décolletage LED"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Qure™ Neck & Décolletage LED User Guide"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "Great skin is waiting… Let's get started!"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Guide Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title"
        },
        {
          "type": "richtext",
          "id": "step_description",
          "label": "Step Description"
        },
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Step Image"
        }
      ]
    },
    {
      "type": "box_item",
      "name": "What's in the Box Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "item_icon",
          "label": "Item Icon"
        },
        {
          "type": "text",
          "id": "item_label",
          "label": "Item Label"
        },
        {
          "type": "text",
          "id": "item_qty",
          "label": "Quantity",
          "default": "1 pc"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Quickstart Steps Guide",
      "category": "Custom"
    }
  ]
}
{% endschema %}