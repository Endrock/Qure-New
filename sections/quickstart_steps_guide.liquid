                                        <h5><span class="me-2">02</span>{{ block.settings.title }}</h5>
                                      </div>
                                  
                                      <div class="accordion accordion-flush" id="accordionFlushExample"> 
                                        {% for i in (1..2) %}
                                          {% assign title_key = "accordion_title_" | append: i %}
                                          {% assign intro_key = "accordion_intro_" | append: i %}
                                          {% assign style_key = "accordion_list_style_" | append: i %}
                                          {% assign title = block.settings[title_key] %}
                                          {% assign intro = block.settings[intro_key] %}
                                          {% assign list_style = block.settings[style_key] %}
                                  
                                          <div class="accordion-item">
                                            <h2 class="accordion-header" id="heading-{{ i }}">
                                              <button class="accordion-button {% unless forloop.first %}collapsed{% endunless %}" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapse-{{ i }}"
                                                aria-expanded="{{ forloop.first }}" aria-controls="collapse-{{ i }}">
                                                {{ title }}
                                              </button>
                                            </h2>
                                            <div id="collapse-{{ i }}" class="accordion-collapse collapse {% if forloop.first %}show{% endif %}"
                                              aria-labelledby="heading-{{ i }}" data-bs-parent="#accordionFlushExample">
                                              <div class="accordion-body">
                                                {% if intro != blank %}
                                                  <p class="mb-3 opacity-8"><strong>{{ intro }}</strong></p>
                                                {% endif %}
                                                <ul class="pb-1 ps-4 {% if list_style == 'number' %}list_style_number{% endif %}">
                                                  {% for j in (1..4) %}
                                                    {% assign item_key = "accordion_item_" | append: i | append: "_" | append: j %}
                                                    {% assign item = block.settings[item_key] %}
                                                    {% if item != blank %}
                                                      <li><span>{{ item }}</span></li>
                                                    {% endif %}
                                                  {% endfor %}
                                                </ul>
                                              </div>
                                            </div>
                                          </div>
                                        {% endfor %}
                                      </div>
                                    </div>
                                  
                                  
