<div class="table-thc container">
  <h2 class="section-title">{{ section.settings.section_title }}</h2>
  <div class="cont-table">
    <table class="table">
      <thead class="header">
        <tr>
          <th class="header-feature">
            <span class="desktop">{{ section.settings.table_feature_title }}</span>
            <span class="mobile">{{ section.settings.table_feature_title_mobile }}</span>
          </th>
          <th class="header-qure">
            <div class="cont-img">
              <img class="logo" src="{{ section.settings.table_qure_title | img_url: 'original' }}" alt="logo">
            </div>
          </th>
          <th class="header-others">{{ section.settings.table_others_title }}</th>
        </tr>
      </thead>
      <tbody class="body">
        {% for block in section.blocks %}
          <tr class="table-row">
            <td class="row-feature">{{ block.settings.row_feature }} </td>
            <td class="row-qure"> 
              <div class="content">
                <span class="icon">
                  {% if block.settings.qure_check == true %}
                    <img class="check" src="{{ section.settings.check_good | img_url: 'original' }}" alt="check">
                  {% else %}
                    <img class="check" src="{{ section.settings.check_error | img_url: 'original' }}" alt="check">
                  {% endif %}
                </span>
                <span class="text">{{ block.settings.row_qure }}</span>
              </div>            
            </td>
            <td class="row-others"> 
              <div class="content">
                <span class="icon">
                  {% if block.settings.others_check == true %}
                    <img class="check" src="{{ section.settings.check_good | img_url: 'original' }}" alt="check">
                  {% else %}
                    <img class="check" src="{{ section.settings.check_error | img_url: 'original' }}" alt="check">
                  {% endif %}
                </span>
                <span class="text">{{ block.settings.row_others }}</span>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{{ 'pwd.theme-styles.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Table Three Columns",
  "tag": "section",
  "class": "section-table-thc",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Heading",
      "default": "Why choose Qure?"
    },
    {
      "type": "text",
      "id": "table_feature_title",
      "label": "Feature Title",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "table_feature_title_mobile",
      "label": "Feature Title Mobile",
      "default": "Why Qure?"
    },
    {
      "type": "image_picker",
      "id": "table_qure_title",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "table_others_title",
      "label": "Table Right Title",
      "default": "Others"
    },
    {
      "type": "image_picker",
      "id": "check_good",
      "label": "Check"
    },
    {
      "type": "image_picker",
      "id": "check_error",
      "label": "Uncheck"
    }
  ],
  "blocks":[
    {
      "type": "row",
      "name": "Row",
      "settings":[
        
        {
          "type": "text",
          "id": "row_feature",
          "label": "Feature Row",
          "default": "Effective, Proven Results"
        },
        {
          "type": "text",
          "id": "row_qure",
          "label": "Qure Row",
          "default": "Targets root causes for lasting change"
        },
        {
          "type": "checkbox",
          "id": "qure_check",
          "label": "Check",
          "default": true
        },
        {
          "type": "text",
          "id": "row_others",
          "label": "Others Row",
          "default": "Often only treat symptoms"
        },
        {
          "type": "checkbox",
          "id": "others_check",
          "label": "Check",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Table Three Columns",
      "category": "Custom",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
