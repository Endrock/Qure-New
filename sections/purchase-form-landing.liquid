<link rel="stylesheet" href="https://qureskincaredns.com/new/assets/product_micro-infusion-pdp.css">

{% include 'assoc-array', section: section, __parent_title: 'type', __separator: '###' %}

<!-- -- main banner start -- -->
<div class="refill_bl pt-0 tabSlider">
    <div class="container">
        <div class="row">
            <div class="col-md-6 order-2 order-md-1">
                <div class="refill_info pt-0 pt-md-3">
                    {%- for block in section.blocks -%}
                        {% if block.type == 'rating' %}
                            {% if block.settings.product != blank %}
                                {% render 'product-rating', rating_value: block.settings.product.metafields.reviews.rating.value, rating_count: block.settings.product.metafields.reviews.rating_count.value %}
                            {% else %}
                                <div class="refill_review mb-2">
                                    <div class="star_gp">
                                        {% if block.settings.image != blank %}
                                            <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}">
                                        {% endif %}
                                    </div>
                                    <p class="text-sm fw-normal" style="text-decoration: none;">{{ block.settings.text }}</p>
                                </div>
                            {% endif %}                        
                        {% endif %}   
                    {%- endfor -%}
                    <div class="section_header text-start ms-0">
                        {% if section.settings.seo_heading != blank %}
                            <h1 class="seo_heading">{{ section.settings.seo_heading }}</h1>
                        {% endif %}
                        {% if section.settings.heading != blank %}
                            <h2 id="page-{{ page.handle | escape }}" class="title-xl d-none d-md-block">{{ section.settings.heading | replace: '\n', '<br />' }}</h2>
                        {% endif %}
                    </div>

                    {%- for block in section.blocks -%}
                        {% if block.type == 'list' %}
                            {% if block.settings.text %}
                                <div class="ss_list mw-427 py-4">
                                    {{ block.settings.text }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {%- endfor -%} 

                    <div class="mw-402">
                        <div class="serum_bl">
                            <div class="s_bl_wrapper">
                                <div class="supply-detail supply-detail-without-counter pb-0">
                                    {% render 'purchase-form-landing-types-section' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
                                    {% render 'purchase-form-landing-products-section' section: section, __idsArray1: __idsArray1, __idsArray2: __idsArray2, __idsArray3: __idsArray3 %}
                                </div>
                            </div>
                        </div>
                        <a class="btn btn-lg btn-primary buy_btn reserve_btn mt-3"
                            href="#productSubscription">Buy Now <span class="savedAmount"> SAVE 43%</span><img
                                src="https://qureskincaredns.com/new/assets/arrow_right.svg" alt="">
                        </a>
                        <div class="payment_method">
                            <p>OR 4 monthly payments of <span class="payment_price">$42.25</span> with</p>
                            <div class="pmt_img ps-2">
                                <img src="https://qureskincaredns.com/new/assets/klarna.svg" alt="">
                                <img src="https://qureskincaredns.com/new/assets/sezzle.svg" alt="">
                                <img src="https://qureskincaredns.com/new/assets/afterpay.svg" alt="">
                            </div>
                        </div>
                        <div class="certified_derm">
                            <img src="https://qureskincaredns.com/new/assets/certified_derma.webp" alt="">
                            <p><b>50+ Board Certified Dermatologists</b> recommended Qure to
                                their patients. <a href="https://qureskincare.com/pages/derm-reviews"
                                    class="text-black text-decoration-underline">See More</a> </p>
                        </div>
                        <div class="shipping shipping_bg bg-transparent py-2main .certified_derm p">
                            <div class="s_bx">
                                <img src="https://qureskincaredns.com/new/assets/dermatologist.svg" alt="">
                                <p>Dermatologist Reviewed</p>
                            </div>
                            <div class="s_bx">
                                <img src="https://qureskincaredns.com/new/assets/shipping.svg" alt="">
                                <p class="d-none d-md-block">Free Shipping Over $100</p>
                                <p class="d-block d-md-none">Free World-Wide Shipping Over $100</p>
                            </div>
                        </div>
                        {% render 'pdm_cross-sell', cross-sell-products: page.metafields.custom.cross_sell.value, visibility: "mobile" %}
                    </div>
                </div>
            </div>
            <div class="col-md-6  order-1 order-md-2">
                {% render 'pdm_before_after_carousel', settings: section.settings %}
                {% render 'pdm_cross-sell', cross-sell-products: page.metafields.custom.cross_sell.value, visibility: "desktop" %}
            </div>
        </div>
    </div>
</div>
<!-- -- main banner end -- -->

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const serumOptions = document.querySelectorAll('input[name="mBanner_serum"]');
        const supplySteps = document.querySelector(".supply_steps.month_plan_steps");
        const nextBatchBl = document.querySelector(".next_batch_bl");
        const buyButton = document.querySelector(".reserve_btn");
        let lastSavedText = buyButton.innerHTML;

        const handleSerumChange = () => {
            let selectedSerum = document.querySelector('input[name="mBanner_serum"]:checked');
            if (selectedSerum && selectedSerum.id === "mBanner_hydra-soothing") {
                nextBatchBl.style.display = "block";
                buyButton.textContent = "Reserve";
            } else {
                nextBatchBl.style.display = "none";
                buyButton.innerHTML = lastSavedText;
            }
            supplySteps.style.display = "block";
        };

        serumOptions.forEach((option) => {
            option.addEventListener("change", handleSerumChange);
        });

        handleSerumChange();

        document.querySelectorAll('.monthly_plans-new').forEach(plan => {
            plan.addEventListener('click', function () {
                let savedTxt = this.querySelector('.saved_price')?.innerHTML;
                if (savedTxt !== undefined) {
                    if (document.body.hasAttribute('data-contrast-horizontal-layout')) {
                        lastSavedText = 'Buy Now <span class="savedAmount"> SAVE ' + savedTxt.replace(/\bOFF\b/, "").trim() + '</span><img src="https://qureskincaredns.com/new/assets/arrow_right.svg" alt="">';
                    } else {
                        lastSavedText = 'Buy Now <span class="savedAmount"> ' + savedTxt + '</span><img src="https://qureskincaredns.com/new/assets/arrow_right.svg" alt="">';
                    }
                } else {
                    lastSavedText = 'Buy Now';
                }
                buyButton.innerHTML = lastSavedText;

                let paymentPrice = this.getAttribute("payment-price");
                document.querySelectorAll('.payment_price').forEach(el => el.innerHTML = paymentPrice !== null ? paymentPrice : '');
            });
        });
    });

</script>


