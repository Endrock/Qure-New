<div class="clinical_grade section {{ section.settings.custom_class }}">
    <div class="container">
    <div class="row">
        <div class="col-12 col-md-6">
        <h2 class="title-lg d-block d-none text-start">
            {{ section.settings.main_heading }}
        </h2>
        <div class="img_grid pe-md-5">
            <div class="cg_main pe-md-3">
            {% if section.settings.main_image_desktop != blank %}
                <img src="{{ section.settings.main_image_desktop | image_url }}" alt="" class="img-fluid h-100 d-none d-md-block">
            {% endif %}
            {% if section.settings.main_image_mobile != blank %}
                <img src="{{ section.settings.main_image_mobile | image_url }}" alt="" class="img-fluid d-block d-md-none">
            {% endif %}
            </div>
        </div>
        </div>

        <div class="col-12 col-md-6">
        <div class="cg_desc">
            <div class="rej_ser_dv d-flex mt-5 mt-md-0">
            <div class="img_ser">
                {% if section.settings.small_image_qure != blank %}
                    <img src="{{ section.settings.small_image_qure | image_url }}" alt="" class="img-fluid">
                {% endif %}
            </div>
            <div class="ser_con">
                <h3 class="title-lg">{{ section.settings.serum_heading }}</h3>

                <div class="d-grid serum_icons_grid mt-3 d-none d-md-grid">
                {% for block in section.blocks %}
                    <div class="icon_ser">
                    {% if block.settings.icon %}
                        <img src="{{ block.settings.icon | image_url }}" alt="" class="img-fluid">
                    {% endif %}
                    <span>{{ block.settings.text }}</span>
                    </div>
                {% endfor %}
                </div>
            </div>
            </div>

            <div class="d-grid serum_icons_grid mt-3 d-md-none">
            {% for block in section.blocks %}
                <div class="icon_ser">
                {% if block.settings.icon %}
                    <img src="{{ block.settings.icon | image_url }}" alt="" class="img-fluid">
                {% endif %}
                <span>{{ block.settings.text }}</span>
                </div>
            {% endfor %}
            </div>

            <div class="accordion accordion-flush mi_acne_accord" id="accordionQuesExample_2">
            <div class="accordion-item u_item_question bg-grey">
                <h2 class="accordion-header u_item_expandable bg-grey">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#u_item_question_4" aria-expanded="true" aria-controls="u_item_question_4">
                    <div class="containers">{{ section.settings.accordion_1_heading }}</div>
                </button>
                </h2>
                <div id="u_item_question_4" class="accordion-collapse collapse show" data-bs-parent="#accordionQuesExample_2">
                <div class="accordion-body">
                    <div class="containers">
                    {{ section.settings.accordion_1_text }}
                    </div>
                </div>
                </div>
            </div>

            <div class="accordion-item u_item_question bg-grey">
                <h2 class="accordion-header u_item_expandable bg-grey">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#u_item_question_6" aria-expanded="false" aria-controls="u_item_question_6">
                    <div class="containers">{{ section.settings.accordion_2_heading }}</div>
                </button>
                </h2>
                <div id="u_item_question_6" class="accordion-collapse collapse" data-bs-parent="#accordionQuesExample_2">
                <div class="accordion-body">
                    <div class="containers">
                    {{ section.settings.accordion_2_text }}
                    </div>
                </div>
                </div>
            </div>
            </div>
            
        </div>
        </div>
    </div>
    </div>
</div>



{% schema %}
{
  "name": "Clinical Grade",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:common.classname.custom"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "We make science-backed skincare easily accessible and affordable"
    },
    {
      "type": "image_picker",
      "id": "main_image_desktop",
      "label": "Main Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "main_image_mobile",
      "label": "Main Image (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "small_image_qure",
      "label": "t:common.image.label"
    },
    {
      "type": "text",
      "id": "serum_heading",
      "label": "Serum Heading",
      "default": "for Dark Spots"
    },
    {
      "type": "text",
      "id": "accordion_1_heading",
      "label": "Accordion Heading",
      "default": "What can it do for your skin"
    },
    {
      "type": "richtext",
      "id": "accordion_1_text",
      "label": "Accordion 1 Text",
      "default": "<p>Works beneath the surface to address dark spots and uneven skin tone...</p>"
    },
    {
        "type": "text",
        "id": "accordion_2_heading",
        "label": "Accordion Heading",
        "default": "All Ingredients" 
      },
    {
      "type": "richtext",
      "id": "accordion_2_text",
      "label": "Accordion 2 Text",
      "default": "<p><strong>Epidermal Growth Factor (EGF):</strong>...</p>"
    }
  ],
  "blocks": [
    {
      "type": "serum_benefit",
      "name": "Serum Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clinical Grade",
      "category": "Custom",
      "blocks": [
        {
          "type": "serum_benefit",
          "settings": {
            "text": "Reduces the look of dark spots"
          }
        },
        {
          "type": "serum_benefit",
          "settings": {
            "text": "Helps break up areas of pigmentation"
          }
        },
        {
          "type": "serum_benefit",
          "settings": {
            "text": "Improves skin texture for a more even appearance"
          }
        }
      ]
    }
  ]
}
{% endschema %}