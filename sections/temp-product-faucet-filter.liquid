<script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>

<script>
    document.addEventListener("DOMContentLoaded", function () 
    {
        const slider = document.getElementById("faucet_after_before_slider");
        const sliderCircle = slider.querySelector(".slider-circle");
        const beforeText = document.getElementById("beforeText");
        const afterText = document.getElementById("afterText");
        const beforeImg = document.getElementById("faucetBefore");
        const afterImg = document.getElementById("faucetAfter");

        let isDragging = false;
        let startX = 0;
        let currentX = 0;
        let skipClick = false;

        function setActiveState(isAfter) {
            if (isAfter) {
                slider.classList.add("active");
                beforeImg.classList.remove("active");
                afterImg.classList.add("active");

                beforeText.classList.remove("active-text");
                beforeText.classList.add("inactive-text");
                afterText.classList.add("active-text");
                afterText.classList.remove("inactive-text");
            } else {
                slider.classList.remove("active");
                beforeImg.classList.add("active");
                afterImg.classList.remove("active");

                beforeText.classList.add("active-text");
                beforeText.classList.remove("inactive-text");
                afterText.classList.remove("active-text");
                afterText.classList.add("inactive-text");
            }
        }

        function onDragStart(e) {
            isDragging = true;
            startX = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
        }

        function onDragMove(e) {
            if (!isDragging) return;
            currentX = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
        }

        function onDragEnd() {
            if (!isDragging) return;

            const deltaX = currentX - startX;
            const isActive = slider.classList.contains("active");

            if (Math.abs(deltaX) > 30) {
                if (deltaX > 0 && !isActive) {
                    setActiveState(true); // Swipe right → After
                    skipClick = true;
                } else if (deltaX < 0 && isActive) {
                    setActiveState(false); // Swipe left → Before
                    skipClick = true;
                }
            }

            isDragging = false;
        }

        // Mouse events
        sliderCircle.addEventListener("mousedown", onDragStart);
        document.addEventListener("mousemove", onDragMove);
        document.addEventListener("mouseup", onDragEnd);

        // Touch events
        sliderCircle.addEventListener("touchstart", onDragStart);
        document.addEventListener("touchmove", onDragMove);
        document.addEventListener("touchend", onDragEnd);

        // Click to toggle (only if not dragged)
        slider.addEventListener("click", () => {
            if (skipClick) {
                skipClick = false;
                return;
            }

            const isActive = slider.classList.contains("active");
            setActiveState(!isActive);
        });

        var elements = $('ul.marquee-item-list li').length;

        for(var i=0;i < elements; i++){
            $(".marquee-item-list").clone().prependTo( ".marquee-block" );
        };
        
        var liEle = [];
        var liEle = $(".marquee-item-list li");


        $('.read-more').click(function () {
            $(this).prev().slideToggle();
            if (($(this).text()) == "See Less") {
                $(this).text("See More");
            } else {
                $(this).text("See Less");
            }
        });

        const container = document.querySelector('.comparsion_inner');
        
        document.querySelector('.slider').addEventListener('input', (e) => {
            container.style.setProperty('--position', `${e.target.value}%`);
        })
    });
</script>